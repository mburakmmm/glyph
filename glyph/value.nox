# Typed template Value model, JSON conversion, truthiness, stringify, and safe checked math.
# Enforces AGENTS.md §5 and ADR-0001. Freestanding-safe (no nox.fs / nox.unicode).
import nox.json
import nox.strings
from nox.json import JsonError
from nox.collections import OrderedDict
from glyph.errors import SourceSpan, GlyphTypeError, GlyphUndefinedError, GlyphSecurityError
from glyph.errors import GLYPH_EVAL_TYPE, GLYPH_EVAL_UNDEFINED, GLYPH_EVAL_OVERFLOW
from glyph.errors import GLYPH_EVAL_DIV_ZERO, GLYPH_EVAL_OUT_OF_RANGE, GLYPH_SECURITY_REFLECTION

enum MarkupContext:
    SafeHtml
    SafeAttr
    SafeUrl
    SafeJs

enum UndefinedPolicy:
    StrictUndefined
    LenientUndefined

enum Value:
    VNull
    VUndefined(name: str)
    VBool(b: bool)
    VInt(i: int)
    VFloat(f: float)
    VStr(s: str)
    VList(items: list[Value])
    VMap(entries: OrderedDict[str, Value])
    VTrustedMarkup(content: str, ctx: MarkupContext)
    VCallable(name: str)

def is_nan(f: float) -> bool:
    return f != f

def is_inf(f: float) -> bool:
    if f != f:
        return False
    return (f - f) != 0.0

def validate_float(f: float, span: SourceSpan) -> float:
    if is_nan(f) or is_inf(f):
        raise GlyphTypeError(
            GLYPH_EVAL_TYPE,
            "non-finite float (NaN or Infinity) is not permitted",
            span,
            "ensure numeric expressions produce finite floats"
        )
    return f

def empty_map() -> Value:
    entries: OrderedDict[str, Value] = OrderedDict[str, Value]()
    return Value.VMap(entries)

def empty_list() -> Value:
    items: list[Value] = []
    return Value.VList(items)

def is_forbidden_key(key: str) -> bool:
    if len(key) >= 2 and nox.strings.starts_with(key, "__"):
        return True
    if key == "constructor" or key == "prototype":
        return True
    return False

def map_get(entries: OrderedDict[str, Value], key: str, span: SourceSpan) -> Value:
    if is_forbidden_key(key):
        raise GlyphSecurityError(
            GLYPH_SECURITY_REFLECTION,
            "access to restricted metadata key is denied",
            span,
            "only plain data fields may be accessed"
        )
    if entries.contains(key):
        return entries.get(key)
    return Value.VUndefined(key)

def list_get(items: list[Value], idx: int, span: SourceSpan) -> Value:
    n: int = len(items)
    pos: int = idx
    if pos < 0:
        pos = n + pos
    if pos < 0 or pos >= n:
        raise GlyphTypeError(
            GLYPH_EVAL_OUT_OF_RANGE,
            "list index out of range",
            span,
            "check list bounds before indexing"
        )
    return items[pos]

def is_truthy(v: Value, policy: UndefinedPolicy, span: SourceSpan) -> bool:
    match v:
        case Value.VNull:
            return False
        case Value.VUndefined(name):
            match policy:
                case UndefinedPolicy.StrictUndefined:
                    raise GlyphUndefinedError(
                        GLYPH_EVAL_UNDEFINED,
                        "undefined variable '" + name + "'",
                        span,
                        "define the variable or provide a |default filter"
                    )
                case UndefinedPolicy.LenientUndefined:
                    return False
        case Value.VBool(b):
            return b
        case Value.VInt(i):
            return i != 0
        case Value.VFloat(f):
            validate_float(f, span)
            return f != 0.0
        case Value.VStr(s):
            return len(s) > 0
        case Value.VList(items):
            return len(items) > 0
        case Value.VMap(entries):
            return entries.size() > 0
        case Value.VTrustedMarkup(content, _):
            return len(content) > 0
        case Value.VCallable(_):
            return True

def stringify(v: Value, policy: UndefinedPolicy, span: SourceSpan) -> str:
    match v:
        case Value.VNull:
            return ""
        case Value.VUndefined(name):
            match policy:
                case UndefinedPolicy.StrictUndefined:
                    raise GlyphUndefinedError(
                        GLYPH_EVAL_UNDEFINED,
                        "undefined variable '" + name + "'",
                        span,
                        "define the variable or use |default"
                    )
                case UndefinedPolicy.LenientUndefined:
                    return ""
        case Value.VBool(b):
            if b:
                return "true"
            return "false"
        case Value.VInt(i):
            return str(i)
        case Value.VFloat(f):
            validate_float(f, span)
            return str(f)
        case Value.VStr(s):
            return s
        case Value.VTrustedMarkup(content, _):
            return content
        case Value.VList(_):
            raise GlyphTypeError(
                GLYPH_EVAL_TYPE,
                "cannot stringify list directly without a filter (e.g. |join or |tojson)",
                span,
                "use |join(', ') or |tojson"
            )
        case Value.VMap(_):
            raise GlyphTypeError(
                GLYPH_EVAL_TYPE,
                "cannot stringify map directly without a filter (e.g. |tojson)",
                span,
                "access a field or use |tojson"
            )
        case Value.VCallable(_):
            raise GlyphTypeError(
                GLYPH_EVAL_TYPE,
                "cannot stringify callable helper directly",
                span,
                "invoke the helper with ()"
            )

def _is_int_json_text(txt: str) -> bool:
    if len(txt) == 0:
        return False
    if nox.strings.contains(txt, ".") or nox.strings.contains(txt, "e") or nox.strings.contains(txt, "E"):
        return False
    return True

def _from_json_pos(jv: JsonValue, p: int, depth: int, span: SourceSpan) -> Value:
    if depth > 64:
        raise GlyphTypeError(
            GLYPH_EVAL_TYPE,
            "JSON nesting depth exceeded maximum limit (64)",
            span,
            "flatten deeply nested JSON inputs"
        )
    knd: int = nox.json.pos_kind(jv, p)
    match knd:
        case 0:
            return Value.VNull
        case 1:
            return Value.VBool(nox.json.pos_bool(jv, p))
        case 2:
            txt: str = nox.json.pos_dump(jv, p)
            if _is_int_json_text(txt):
                try:
                    return Value.VInt(nox.json.pos_int(jv, p))
                except JsonError:
                    raise GlyphTypeError(
                        GLYPH_EVAL_OVERFLOW,
                        "JSON integer exceeds 64-bit signed integer range",
                        span,
                        "pass oversized integers as strings"
                    )
            fv: float = nox.json.pos_number(jv, p)
            validate_float(fv, span)
            return Value.VFloat(fv)
        case 3:
            return Value.VStr(nox.json.pos_str(jv, p))
        case 4:
            n: int = nox.json.pos_len(jv, p)
            out: list[Value] = []
            i: int = 0
            while i < n:
                out.append(_from_json_pos(jv, nox.json.pos_at(jv, p, i), depth + 1, span))
                i = i + 1
            return Value.VList(out)
        case 5:
            n_obj: int = nox.json.pos_len(jv, p)
            entries: OrderedDict[str, Value] = OrderedDict[str, Value]()
            j: int = 0
            while j < n_obj:
                k: str = nox.json.pos_key(jv, p, j)
                if not is_forbidden_key(k):
                    entries.set(k, _from_json_pos(jv, nox.json.pos_at(jv, p, j), depth + 1, span))
                j = j + 1
            return Value.VMap(entries)
        case _:
            raise GlyphTypeError(
                GLYPH_EVAL_TYPE,
                "unsupported JSON value kind",
                span,
                "provide valid JSON data"
            )

# Converts a JsonValue tree into Glyph Value using zero-node pos_* traversal for containers.
# Preserves 64-bit integer precision via pos_dump/pos_int; never promotes JSON data to TrustedMarkup.
def from_json(jv: JsonValue, span: SourceSpan) -> Value:
    if nox.json.is_array(jv) or nox.json.is_object(jv):
        return _from_json_pos(jv, nox.json.pos_root(jv), 0, span)
    if nox.json.is_null(jv):
        return Value.VNull
    if nox.json.is_bool(jv):
        return Value.VBool(nox.json.as_bool(jv))
    if nox.json.is_number(jv):
        txt: str = nox.json.number_text(jv)
        if _is_int_json_text(txt):
            try:
                iv: int = nox.json.as_int(jv)
                return Value.VInt(iv)
            except JsonError:
                raise GlyphTypeError(
                    GLYPH_EVAL_OVERFLOW,
                    "JSON integer exceeds 64-bit signed integer range",
                    span,
                    "pass oversized integers as strings"
                )
        fv: float = nox.json.as_number(jv)
        validate_float(fv, span)
        return Value.VFloat(fv)
    if nox.json.is_string(jv):
        return Value.VStr(nox.json.as_string(jv))
    raise GlyphTypeError(
        GLYPH_EVAL_TYPE,
        "unsupported JSON value kind",
        span,
        "provide valid JSON data"
    )

def from_json_str(raw: str, span: SourceSpan) -> Value:
    try:
        jv: JsonValue = nox.json.parse(raw)
        return from_json(jv, span)
    except JsonError:
        raise GlyphTypeError(
            GLYPH_EVAL_TYPE,
            "invalid JSON payload",
            span,
            "check JSON syntax"
        )

# Signed 64-bit integer bounds for overflow checks
INT64_MAX: int = 9223372036854775807
INT64_MIN: int = -9223372036854775807 - 1

def checked_add(a: int, b: int, span: SourceSpan) -> int:
    if b > 0 and a > INT64_MAX - b:
        raise GlyphTypeError(GLYPH_EVAL_OVERFLOW, "integer addition overflow", span, "use smaller integers")
    if b < 0 and a < INT64_MIN - b:
        raise GlyphTypeError(GLYPH_EVAL_OVERFLOW, "integer addition underflow", span, "use larger integers")
    return a + b

def checked_sub(a: int, b: int, span: SourceSpan) -> int:
    if b < 0 and a > INT64_MAX + b:
        raise GlyphTypeError(GLYPH_EVAL_OVERFLOW, "integer subtraction overflow", span, "use smaller integers")
    if b > 0 and a < INT64_MIN + b:
        raise GlyphTypeError(GLYPH_EVAL_OVERFLOW, "integer subtraction underflow", span, "use larger integers")
    return a - b

def checked_mul(a: int, b: int, span: SourceSpan) -> int:
    if a == 0 or b == 0:
        return 0
    if a > 0:
        if b > 0:
            if a > INT64_MAX // b:
                raise GlyphTypeError(GLYPH_EVAL_OVERFLOW, "integer multiplication overflow", span, "use smaller integers")
        else:
            if b < INT64_MIN // a:
                raise GlyphTypeError(GLYPH_EVAL_OVERFLOW, "integer multiplication underflow", span, "use smaller integers")
    else:
        if b > 0:
            if a < INT64_MIN // b:
                raise GlyphTypeError(GLYPH_EVAL_OVERFLOW, "integer multiplication underflow", span, "use smaller integers")
        else:
            if a < INT64_MAX // b:
                raise GlyphTypeError(GLYPH_EVAL_OVERFLOW, "integer multiplication overflow", span, "use smaller integers")
    return a * b

def checked_floordiv(a: int, b: int, span: SourceSpan) -> int:
    if b == 0:
        raise GlyphTypeError(GLYPH_EVAL_DIV_ZERO, "integer division by zero", span, "ensure divisor is non-zero")
    if a == INT64_MIN and b == -1:
        raise GlyphTypeError(GLYPH_EVAL_OVERFLOW, "integer division overflow", span, "avoid INT64_MIN // -1")
    return a // b

def checked_mod(a: int, b: int, span: SourceSpan) -> int:
    if b == 0:
        raise GlyphTypeError(GLYPH_EVAL_DIV_ZERO, "integer modulo by zero", span, "ensure divisor is non-zero")
    if a == INT64_MIN and b == -1:
        return 0
    return a % b

def check_not_undef(v: Value, policy: UndefinedPolicy, span: SourceSpan) -> Value:
    match v:
        case Value.VUndefined(name):
            match policy:
                case UndefinedPolicy.StrictUndefined:
                    raise GlyphUndefinedError(
                        GLYPH_EVAL_UNDEFINED,
                        "undefined variable '" + name + "'",
                        span,
                        "define '" + name + "' or use |default"
                    )
                case UndefinedPolicy.LenientUndefined:
                    return Value.VNull
        case _:
            return v

def values_equal(a: Value, b: Value, policy: UndefinedPolicy, span: SourceSpan) -> bool:
    va: Value = check_not_undef(a, policy, span)
    vb: Value = check_not_undef(b, policy, span)
    match va:
        case Value.VNull:
            match vb:
                case Value.VNull:
                    return True
                case _:
                    return False
        case Value.VBool(ba):
            match vb:
                case Value.VBool(bb):
                    return ba == bb
                case _:
                    return False
        case Value.VInt(ia):
            match vb:
                case Value.VInt(ib):
                    return ia == ib
                case Value.VFloat(fb):
                    return float(ia) == fb
                case _:
                    return False
        case Value.VFloat(fa):
            match vb:
                case Value.VFloat(fb2):
                    return fa == fb2
                case Value.VInt(ib2):
                    return fa == float(ib2)
                case _:
                    return False
        case Value.VStr(sa):
            match vb:
                case Value.VStr(sb):
                    return sa == sb
                case Value.VTrustedMarkup(cb, _):
                    return sa == cb
                case _:
                    return False
        case Value.VTrustedMarkup(ca, _):
            match vb:
                case Value.VTrustedMarkup(cb2, _):
                    return ca == cb2
                case Value.VStr(sb2):
                    return ca == sb2
                case _:
                    return False
        case Value.VList(la):
            match vb:
                case Value.VList(lb):
                    if len(la) != len(lb):
                        return False
                    i: int = 0
                    while i < len(la):
                        if not values_equal(la[i], lb[i], policy, span):
                            return False
                        i = i + 1
                    return True
                case _:
                    return False
        case Value.VMap(ma):
            match vb:
                case Value.VMap(mb):
                    if ma.size() != mb.size():
                        return False
                    keys: list[str] = ma.keys_list()
                    j: int = 0
                    while j < len(keys):
                        k: str = keys[j]
                        if not mb.contains(k):
                            return False
                        if not values_equal(ma.get(k), mb.get(k), policy, span):
                            return False
                        j = j + 1
                    return True
                case _:
                    return False
        case Value.VUndefined(_):
            return False
        case Value.VCallable(na):
            match vb:
                case Value.VCallable(nb):
                    return na == nb
                case _:
                    return False

def values_compare(a: Value, b: Value, policy: UndefinedPolicy, span: SourceSpan) -> int:
    va: Value = check_not_undef(a, policy, span)
    vb: Value = check_not_undef(b, policy, span)
    match va:
        case Value.VInt(ia):
            match vb:
                case Value.VInt(ib):
                    if ia < ib:
                        return -1
                    elif ia > ib:
                        return 1
                    return 0
                case Value.VFloat(fb):
                    fa: float = float(ia)
                    if fa < fb:
                        return -1
                    elif fa > fb:
                        return 1
                    return 0
                case _:
                    raise GlyphTypeError(GLYPH_EVAL_TYPE, "cannot compare integer with non-number", span, "compare matching types")
        case Value.VFloat(fa2):
            match vb:
                case Value.VFloat(fb2):
                    if fa2 < fb2:
                        return -1
                    elif fa2 > fb2:
                        return 1
                    return 0
                case Value.VInt(ib2):
                    fb3: float = float(ib2)
                    if fa2 < fb3:
                        return -1
                    elif fa2 > fb3:
                        return 1
                    return 0
                case _:
                    raise GlyphTypeError(GLYPH_EVAL_TYPE, "cannot compare float with non-number", span, "compare matching types")
        case Value.VStr(sa):
            match vb:
                case Value.VStr(sb):
                    if sa < sb:
                        return -1
                    elif sa > sb:
                        return 1
                    return 0
                case _:
                    raise GlyphTypeError(GLYPH_EVAL_TYPE, "cannot compare string with non-string", span, "compare matching types")
        case _:
            raise GlyphTypeError(GLYPH_EVAL_TYPE, "ordered comparison requires numbers or strings", span, "use == or != for non-orderable values")

def values_contains(needle: Value, haystack: Value, policy: UndefinedPolicy, span: SourceSpan) -> bool:
    vn: Value = check_not_undef(needle, policy, span)
    vh: Value = check_not_undef(haystack, policy, span)
    match vh:
        case Value.VList(items):
            i: int = 0
            while i < len(items):
                if values_equal(vn, items[i], policy, span):
                    return True
                i = i + 1
            return False
        case Value.VMap(entries):
            match vn:
                case Value.VStr(k):
                    return entries.contains(k)
                case _:
                    raise GlyphTypeError(GLYPH_EVAL_TYPE, "map membership check requires string key", span, "check string key 'in' map")
        case Value.VStr(s):
            match vn:
                case Value.VStr(sub):
                    return nox.strings.contains(s, sub)
                case _:
                    raise GlyphTypeError(GLYPH_EVAL_TYPE, "string membership check requires string needle", span, "check string 'in' string")
        case _:
            raise GlyphTypeError(GLYPH_EVAL_TYPE, "'in' expects list, map, or string", span, "pass a collection or string")

def value_to_json_raw(val: Value, policy: UndefinedPolicy, depth: int, span: SourceSpan) -> str:
    if depth > 64:
        raise GlyphTypeError(GLYPH_EVAL_TYPE, "JSON nesting depth exceeded maximum limit (64)", span, "flatten deeply nested structures")
    match val:
        case Value.VNull:
            return "null"
        case Value.VBool(b):
            if b:
                return "true"
            return "false"
        case Value.VInt(i):
            return str(i)
        case Value.VFloat(f):
            vf: float = validate_float(f, span)
            return str(vf)
        case Value.VStr(s):
            return nox.json.dump_string(s)
        case Value.VTrustedMarkup(c, _):
            return nox.json.dump_string(c)
        case Value.VList(items):
            parts: list[str] = []
            i: int = 0
            while i < len(items):
                parts.append(value_to_json_raw(items[i], policy, depth + 1, span))
                i = i + 1
            return "[" + nox.strings.join(parts, ",") + "]"
        case Value.VMap(entries):
            keys: list[str] = entries.keys_list()
            pairs: list[str] = []
            ki: int = 0
            while ki < len(keys):
                k: str = keys[ki]
                ev: Value = entries.get(k)
                pairs.append(nox.json.dump_string(k) + ":" + value_to_json_raw(ev, policy, depth + 1, span))
                ki = ki + 1
            return "{" + nox.strings.join(pairs, ",") + "}"
        case Value.VUndefined(name):
            match policy:
                case UndefinedPolicy.LenientUndefined:
                    return "null"
                case _:
                    raise GlyphTypeError(
                        GLYPH_EVAL_TYPE,
                        "cannot serialize undefined variable '" + name + "' to JSON",
                        span,
                        "define '" + name + "' or apply |default"
                    )
        case Value.VCallable(cname):
            raise GlyphTypeError(
                GLYPH_EVAL_TYPE,
                "cannot serialize callable '" + cname + "' to JSON",
                span,
                "pass data values rather than callables to JSON output"
            )
