# Extension specification contracts and isolated HelperContext for Glyph (Phase 7).
# Enforces AGENTS.md §13.1: helpers receive immutable policy + locale + shared budget + diagnostics, NEVER full RenderScope.
from glyph.errors import SourceSpan
from glyph.limits import BudgetTracker
from glyph.options import OutputMode, TrustTier
from glyph.value import UndefinedPolicy

enum CostClass:
    Trivial
    Linear
    QuadraticBounded
    Sorting

class FilterSpec:
    namespace_name: str
    name: str
    min_args: int
    max_args: int
    input_types: str
    result_type: str
    is_pure: bool
    is_deterministic: bool
    allowed_contexts: str
    needs_locale: bool
    cost_class: CostClass
    maximum_expansion: int
    min_trust_tier: TrustTier

    def __init__(
        self: FilterSpec,
        namespace_name: str,
        name: str,
        min_args: int,
        max_args: int,
        input_types: str,
        result_type: str,
        is_pure: bool,
        is_deterministic: bool,
        allowed_contexts: str,
        needs_locale: bool,
        cost_class: CostClass,
        maximum_expansion: int,
        min_trust_tier: TrustTier
    ) -> None:
        self.namespace_name = namespace_name
        self.name = name
        self.min_args = min_args
        self.max_args = max_args
        self.input_types = input_types
        self.result_type = result_type
        self.is_pure = is_pure
        self.is_deterministic = is_deterministic
        self.allowed_contexts = allowed_contexts
        self.needs_locale = needs_locale
        self.cost_class = cost_class
        self.maximum_expansion = maximum_expansion
        self.min_trust_tier = min_trust_tier

