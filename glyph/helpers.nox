class HelperContext:
    locale: str
    output_mode: OutputMode
    autoescape: bool
    undefined_policy: UndefinedPolicy
    trust_tier: TrustTier
    tracker: BudgetTracker
    diagnostics: list[str]

    def __init__(
        self: HelperContext,
        locale: str,
        output_mode: OutputMode,
        autoescape: bool,
        undefined_policy: UndefinedPolicy,
        trust_tier: TrustTier,
        tracker: BudgetTracker
    ) -> None:
        self.locale = locale
        self.output_mode = output_mode
        self.autoescape = autoescape
        self.undefined_policy = undefined_policy
        self.trust_tier = trust_tier
        self.tracker = tracker
        empty_diag: list[str] = []
        self.diagnostics = empty_diag

    def add_warning(self: HelperContext, msg: str) -> None:
        ds: list[str] = self.diagnostics
        if len(ds) < 64:
            ds.append(msg)
            self.diagnostics = ds

    def consume_op(self: HelperContext, span: SourceSpan) -> None:
        self.tracker.consume_op(span)
