# FilterRegistry, FilterSpec catalog, and full built-in filter dispatch for Glyph (Phase 7).
# Enforces AGENTS.md §2.5, §2.8, §13.1-13.2: pure/deterministic/bounded filters, HelperContext isolation, immutable during active renders.
import nox.strings
import nox.json
from glyph.errors import SourceSpan, GlyphTypeError, GlyphSecurityError, GlyphExtensionError
from glyph.errors import GLYPH_EVAL_TYPE, GLYPH_SECURITY_POLICY, GLYPH_EXTENSION_ERROR
from glyph.helpers import CostClass, FilterSpec, HelperContext
from glyph.limits import BudgetTracker
from glyph.options import OutputMode, TrustTier
from glyph.value import Value, MarkupContext, UndefinedPolicy, is_truthy, stringify, validate_float
from glyph.safety import escape_html_with_span, escape_json_for_html_script
from glyph.filters_text import FilterArgValue, expect_no_filter_args, expect_max_filter_args, get_filter_arg, expect_bool_arg
from glyph.filters_text import filter_case, filter_capitalize, filter_title, filter_trim, filter_replace, filter_truncate
from glyph.filters_text import filter_wordcount, filter_indent, filter_center, filter_pad, filter_striptags
from glyph.filters_text import filter_normalize_unicode, filter_urlencode, filter_slugify, filter_xml_escape
from glyph.filters_text import filter_forceescape, filter_md_escape, filter_abs, filter_round, filter_to_int, filter_to_float
from glyph.filters_text import filter_number, filter_currency, filter_percent, filter_filesize, filter_date, filter_relative_time
from glyph.filters_collections import filter_length, filter_first_last, filter_reverse, filter_join, filter_sort
from glyph.filters_collections import filter_unique, filter_map, filter_select_reject, filter_batch, filter_slice
from glyph.filters_collections import filter_sum, filter_extremum, filter_groupby, filter_dictsort

def _is_core_filter_name(name: str) -> bool:
    if name == "escape" or name == "e" or name == "forceescape" or name == "safe" or name == "raw" or name == "tojson" or name == "xml_escape":
        return True
    if name == "upper" or name == "lower" or name == "capitalize" or name == "title" or name == "trim" or name == "replace":
        return True
    if name == "truncate" or name == "wordcount" or name == "indent" or name == "center" or name == "pad" or name == "striptags":
        return True
    if name == "normalize_unicode" or name == "urlencode" or name == "slugify" or name == "md_escape":
        return True
    if name == "length" or name == "first" or name == "last" or name == "reverse" or name == "sort" or name == "unique" or name == "join":
        return True
    if name == "map" or name == "select" or name == "reject" or name == "batch" or name == "slice" or name == "sum" or name == "min" or name == "max" or name == "groupby" or name == "dictsort":
        return True
    if name == "abs" or name == "round" or name == "int" or name == "float" or name == "number" or name == "currency" or name == "percent" or name == "filesize":
        return True
    if name == "default" or name == "string" or name == "date" or name == "datetime" or name == "relative_time":
        return True
    return False

def _mk_fspec(
    name: str,
    min_a: int,
    max_a: int,
    in_t: str,
    res_t: str,
    ctxs: str,
    loc: bool,
    cost: CostClass,
    max_exp: int,
    trust: TrustTier
) -> FilterSpec:
    return FilterSpec("core", name, min_a, max_a, in_t, res_t, True, True, ctxs, loc, cost, max_exp, trust)

def builtin_filter_specs() -> list[FilterSpec]:
    return [
        _mk_fspec("escape", 0, 0, "any", "SafeHtml", "html", False, CostClass.Linear, 6, TrustTier.Untrusted),
        _mk_fspec("forceescape", 0, 0, "any", "SafeHtml", "html", False, CostClass.Linear, 6, TrustTier.Untrusted),
        _mk_fspec("safe", 0, 0, "any", "SafeHtml", "html", False, CostClass.Trivial, 1, TrustTier.Trusted),
        _mk_fspec("tojson", 0, 0, "any", "SafeJs", "html_script", False, CostClass.Linear, 6, TrustTier.Untrusted),
        _mk_fspec("xml_escape", 0, 0, "any", "string", "xml", False, CostClass.Linear, 6, TrustTier.Untrusted),
        _mk_fspec("upper", 0, 0, "any", "string", "any", True, CostClass.Linear, 2, TrustTier.Untrusted),
        _mk_fspec("lower", 0, 0, "any", "string", "any", True, CostClass.Linear, 2, TrustTier.Untrusted),
        _mk_fspec("capitalize", 0, 0, "any", "string", "any", True, CostClass.Linear, 2, TrustTier.Untrusted),
        _mk_fspec("title", 0, 0, "any", "string", "any", True, CostClass.Linear, 2, TrustTier.Untrusted),
        _mk_fspec("trim", 0, 0, "any", "string", "any", False, CostClass.Linear, 1, TrustTier.Untrusted),
        _mk_fspec("replace", 2, 3, "any", "string", "any", False, CostClass.Linear, 1048576, TrustTier.Untrusted),
        _mk_fspec("truncate", 0, 3, "any", "string", "any", False, CostClass.Linear, 1, TrustTier.Untrusted),
        _mk_fspec("wordcount", 0, 0, "any", "integer", "any", False, CostClass.Linear, 1, TrustTier.Untrusted),
        _mk_fspec("indent", 0, 3, "any", "string", "any", False, CostClass.Linear, 1048576, TrustTier.Untrusted),
        _mk_fspec("center", 0, 2, "any", "string", "any", False, CostClass.Linear, 4096, TrustTier.Untrusted),
        _mk_fspec("pad", 1, 3, "any", "string", "any", False, CostClass.Linear, 4096, TrustTier.Untrusted),
        _mk_fspec("striptags", 0, 0, "any", "string", "any", False, CostClass.Linear, 1, TrustTier.Untrusted),
        _mk_fspec("normalize_unicode", 0, 1, "any", "string", "any", False, CostClass.Linear, 1, TrustTier.Untrusted),
        _mk_fspec("urlencode", 0, 0, "any", "string", "any", False, CostClass.Linear, 3, TrustTier.Untrusted),
        _mk_fspec("slugify", 0, 1, "any", "string", "any", True, CostClass.Linear, 2, TrustTier.Untrusted),
        _mk_fspec("md_escape", 0, 0, "any", "string", "markdown", False, CostClass.Linear, 2, TrustTier.Untrusted),
        _mk_fspec("length", 0, 0, "string|list|map", "integer", "any", False, CostClass.Trivial, 1, TrustTier.Untrusted),
        _mk_fspec("first", 0, 0, "string|list", "any", "any", False, CostClass.Trivial, 1, TrustTier.Untrusted),
        _mk_fspec("last", 0, 0, "string|list", "any", "any", False, CostClass.Trivial, 1, TrustTier.Untrusted),
        _mk_fspec("reverse", 0, 0, "string|list", "string|list", "any", False, CostClass.Linear, 1, TrustTier.Untrusted),
        _mk_fspec("sort", 0, 2, "list", "list", "any", False, CostClass.Sorting, 1, TrustTier.Untrusted),
        _mk_fspec("unique", 0, 1, "list", "list", "any", False, CostClass.QuadraticBounded, 1, TrustTier.Untrusted),
        _mk_fspec("join", 0, 1, "list", "string", "any", False, CostClass.Linear, 1048576, TrustTier.Untrusted),
        _mk_fspec("map", 1, 1, "list", "list", "any", False, CostClass.Linear, 1, TrustTier.Untrusted),
        _mk_fspec("select", 1, 3, "list", "list", "any", False, CostClass.Linear, 1, TrustTier.Untrusted),
        _mk_fspec("reject", 1, 3, "list", "list", "any", False, CostClass.Linear, 1, TrustTier.Untrusted),
        _mk_fspec("batch", 1, 2, "list", "list", "any", False, CostClass.Linear, 1, TrustTier.Untrusted),
        _mk_fspec("slice", 1, 2, "list", "list", "any", False, CostClass.Linear, 1, TrustTier.Untrusted),
        _mk_fspec("sum", 0, 2, "list", "number", "any", False, CostClass.Linear, 1, TrustTier.Untrusted),
        _mk_fspec("min", 0, 1, "list", "any", "any", False, CostClass.Linear, 1, TrustTier.Untrusted),
        _mk_fspec("max", 0, 1, "list", "any", "any", False, CostClass.Linear, 1, TrustTier.Untrusted),
        _mk_fspec("groupby", 1, 1, "list", "list", "any", False, CostClass.QuadraticBounded, 1, TrustTier.Untrusted),
        _mk_fspec("dictsort", 0, 3, "map", "list", "any", False, CostClass.Sorting, 1, TrustTier.Untrusted),
        _mk_fspec("abs", 0, 0, "number", "number", "any", False, CostClass.Trivial, 1, TrustTier.Untrusted),
        _mk_fspec("round", 0, 2, "number", "float", "any", False, CostClass.Trivial, 1, TrustTier.Untrusted),
        _mk_fspec("int", 0, 1, "any", "integer", "any", False, CostClass.Trivial, 1, TrustTier.Untrusted),
        _mk_fspec("float", 0, 1, "any", "float", "any", False, CostClass.Trivial, 1, TrustTier.Untrusted),
        _mk_fspec("string", 0, 0, "any", "string", "any", False, CostClass.Linear, 1, TrustTier.Untrusted),
        _mk_fspec("default", 0, 2, "any", "any", "any", False, CostClass.Trivial, 1, TrustTier.Untrusted),
        _mk_fspec("number", 0, 1, "number", "string", "any", True, CostClass.Linear, 2, TrustTier.Untrusted),
        _mk_fspec("currency", 0, 2, "number", "string", "any", True, CostClass.Linear, 2, TrustTier.Untrusted),
        _mk_fspec("percent", 0, 1, "number", "string", "any", True, CostClass.Linear, 2, TrustTier.Untrusted),
        _mk_fspec("filesize", 0, 1, "number", "string", "any", False, CostClass.Trivial, 1, TrustTier.Untrusted),
        _mk_fspec("date", 0, 1, "int|string", "string", "any", False, CostClass.Trivial, 1, TrustTier.Untrusted),
        _mk_fspec("datetime", 0, 1, "int|string", "string", "any", False, CostClass.Trivial, 1, TrustTier.Untrusted),
        _mk_fspec("relative_time", 1, 1, "int|string", "string", "any", False, CostClass.Trivial, 1, TrustTier.Untrusted)
    ]

class FilterRegistry:
    allow_safe: bool
    custom_names: list[str]
    custom_fns: list[(Value, list[FilterArgValue], HelperContext, SourceSpan) -> Value]
    custom_specs: list[FilterSpec]
    generation: int
    active_renders: int
    frozen: bool

    def __init__(self: FilterRegistry, allow_safe: bool) -> None:
        self.allow_safe = allow_safe
        empty_names: list[str] = []
        empty_fns: list[(Value, list[FilterArgValue], HelperContext, SourceSpan) -> Value] = []
        empty_specs: list[FilterSpec] = []
        self.custom_names = empty_names
        self.custom_fns = empty_fns
        self.custom_specs = empty_specs
        self.generation = 1
        self.active_renders = 0
        self.frozen = False

    def begin_use(self: FilterRegistry) -> None:
        if self.frozen:
            return
        self.active_renders = self.active_renders + 1

    def end_use(self: FilterRegistry) -> None:
        if self.frozen:
            return
        if self.active_renders > 0:
            self.active_renders = self.active_renders - 1

    def freeze(self: FilterRegistry) -> None:
        self.frozen = True

    def register_with_spec(
        self: FilterRegistry,
        spec: FilterSpec,
        fn: (Value, list[FilterArgValue], HelperContext, SourceSpan) -> Value
    ) -> None:
        reg_sp: SourceSpan = SourceSpan("<registry>", 1, 1, 0, 0)
        if self.frozen or self.active_renders > 0:
            raise GlyphExtensionError(
                GLYPH_EXTENSION_ERROR,
                "cannot modify FilterRegistry while rendering is active or frozen",
                reg_sp,
                "register filters on Environment before rendering begins"
            )
        full_name: str = spec.name
        if len(spec.namespace_name) > 0 and spec.namespace_name != "custom" and spec.namespace_name != "core" and not nox.strings.contains(full_name, "."):
            full_name = spec.namespace_name + "." + spec.name
        if _is_core_filter_name(full_name):
            raise GlyphExtensionError(
                GLYPH_EXTENSION_ERROR,
                "cannot override core filter '" + full_name + "'",
                reg_sp,
                "register custom filters under a distinct name"
            )
        names: list[str] = self.custom_names
        fns: list[(Value, list[FilterArgValue], HelperContext, SourceSpan) -> Value] = self.custom_fns
        specs: list[FilterSpec] = self.custom_specs
        i: int = 0
        while i < len(names):
            if names[i] == full_name:
                fns[i] = fn
                specs[i] = spec
                self.custom_fns = fns
                self.custom_specs = specs
                self.generation = self.generation + 1
                return
            i = i + 1
        names.append(full_name)
        fns.append(fn)
        specs.append(spec)
        self.custom_names = names
        self.custom_fns = fns
        self.custom_specs = specs
        self.generation = self.generation + 1

    def register(
        self: FilterRegistry,
        name: str,
        fn: (Value, list[FilterArgValue], BudgetTracker, SourceSpan) -> Value
    ) -> None:
        def wrapped(v: Value, args: list[FilterArgValue], hctx: HelperContext, span: SourceSpan) -> Value:
            return fn(v, args, hctx.tracker, span)
        sp: FilterSpec = FilterSpec("custom", name, 0, 8, "any", "any", True, True, "any", False, CostClass.Linear, 65536, TrustTier.Untrusted)
        self.register_with_spec(sp, wrapped)

    def all_specs(self: FilterRegistry) -> list[FilterSpec]:
        out: list[FilterSpec] = builtin_filter_specs()
        i: int = 0
        while i < len(self.custom_specs):
            out.append(self.custom_specs[i])
            i = i + 1
        return out

def default_filters(allow_safe: bool) -> FilterRegistry:
    return FilterRegistry(allow_safe)

def _filter_escape(val: Value, args: list[FilterArgValue], policy: UndefinedPolicy, span: SourceSpan) -> Value:
    expect_no_filter_args("escape", args, span)
    match val:
        case Value.VTrustedMarkup(content, ctx):
            match ctx:
                case MarkupContext.SafeHtml:
                    return val
                case _:
                    return Value.VTrustedMarkup(escape_html_with_span(content, span), MarkupContext.SafeHtml)
        case _:
            raw: str = stringify(val, policy, span)
            return Value.VTrustedMarkup(escape_html_with_span(raw, span), MarkupContext.SafeHtml)

def _filter_default(val: Value, args: list[FilterArgValue], policy: UndefinedPolicy, span: SourceSpan) -> Value:
    expect_max_filter_args("default", args, 2, span)
    def_val: Value = get_filter_arg(args, 0, "default_value", Value.VStr(""))
    check_falsy: bool = expect_bool_arg(get_filter_arg(args, 1, "boolean", Value.VBool(False)), "default", "boolean", span)
    match val:
        case Value.VUndefined(_):
            return def_val
        case _:
            if check_falsy:
                if not is_truthy(val, policy, span):
                    return def_val
            return val

def _value_to_json(val: Value, policy: UndefinedPolicy, tracker: BudgetTracker, depth: int, span: SourceSpan) -> str:
    tracker.consume_op(span)
    if depth > 64:
        raise GlyphTypeError(GLYPH_EVAL_TYPE, "tojson nesting depth exceeded maximum limit (64)", span, "flatten deeply nested structures before calling |tojson")
    match val:
        case Value.VNull:
            return "null"
        case Value.VBool(b):
            if b:
                return "true"
            return "false"
        case Value.VInt(i):
            return str(i)
        case Value.VFloat(f):
            vf: float = validate_float(f, span)
            return str(vf)
        case Value.VStr(s):
            return nox.json.dump_string(s)
        case Value.VTrustedMarkup(c, _):
            return nox.json.dump_string(c)
        case Value.VList(items):
            parts: list[str] = []
            i: int = 0
            while i < len(items):
                parts.append(_value_to_json(items[i], policy, tracker, depth + 1, span))
                i = i + 1
            return "[" + nox.strings.join(parts, ",") + "]"
        case Value.VMap(entries):
            keys: list[str] = entries.keys_list()
            pairs: list[str] = []
            ki: int = 0
            while ki < len(keys):
                k: str = keys[ki]
                ev: Value = entries.get(k)
                pairs.append(nox.json.dump_string(k) + ":" + _value_to_json(ev, policy, tracker, depth + 1, span))
                ki = ki + 1
            return "{" + nox.strings.join(pairs, ",") + "}"
        case Value.VUndefined(name):
            match policy:
                case UndefinedPolicy.LenientUndefined:
                    return "null"
                case _:
                    raise GlyphTypeError(GLYPH_EVAL_TYPE, "cannot serialize undefined variable '" + name + "' with |tojson", span, "define '" + name + "' or apply |default before |tojson")
        case Value.VCallable(cname):
            raise GlyphTypeError(GLYPH_EVAL_TYPE, "cannot serialize callable '" + cname + "' with |tojson", span, "pass data values rather than callables to |tojson")

def _filter_tojson(val: Value, args: list[FilterArgValue], policy: UndefinedPolicy, tracker: BudgetTracker, span: SourceSpan) -> Value:
    expect_no_filter_args("tojson", args, span)
    raw_json: str = _value_to_json(val, policy, tracker, 0, span)
    safe_json: str = escape_json_for_html_script(raw_json)
    return Value.VTrustedMarkup(safe_json, MarkupContext.SafeJs)

def apply_filter_with_context(
    reg: FilterRegistry,
    name: str,
    val: Value,
    args: list[FilterArgValue],
    hctx: HelperContext,
    span: SourceSpan
) -> Value:
    hctx.consume_op(span)
    # Escaping & Policy
    if name == "escape" or name == "e":
        return _filter_escape(val, args, hctx.undefined_policy, span)
    if name == "forceescape":
        return filter_forceescape(val, args, hctx, span)
    if name == "tojson":
        return _filter_tojson(val, args, hctx.undefined_policy, hctx.tracker, span)
    if name == "xml_escape":
        return filter_xml_escape(val, args, hctx, span)
    if name == "safe" or name == "raw":
        can_safe: bool = reg.allow_safe
        match hctx.trust_tier:
            case TrustTier.Trusted:
                pass
            case _:
                can_safe = False
        if not can_safe:
            raise GlyphSecurityError(
                GLYPH_SECURITY_POLICY,
                "filter '" + name + "' is disabled in safe-by-default/restricted mode",
                span,
                "use typed TrustedMarkup from host context instead"
            )
        expect_no_filter_args(name, args, span)
        return Value.VTrustedMarkup(stringify(val, hctx.undefined_policy, span), MarkupContext.SafeHtml)

    # Strings & Markdown
    if name == "upper":
        return filter_case(val, args, True, hctx, span)
    if name == "lower":
        return filter_case(val, args, False, hctx, span)
    if name == "capitalize":
        return filter_capitalize(val, args, hctx, span)
    if name == "title":
        return filter_title(val, args, hctx, span)
    if name == "trim":
        return filter_trim(val, args, hctx, span)
    if name == "replace":
        return filter_replace(val, args, hctx, span)
    if name == "truncate":
        return filter_truncate(val, args, hctx, span)
    if name == "wordcount":
        return filter_wordcount(val, args, hctx, span)
    if name == "indent":
        return filter_indent(val, args, hctx, span)
    if name == "center":
        return filter_center(val, args, hctx, span)
    if name == "pad":
        return filter_pad(val, args, hctx, span)
    if name == "striptags":
        return filter_striptags(val, args, hctx, span)
    if name == "normalize_unicode":
        return filter_normalize_unicode(val, args, hctx, span)
    if name == "urlencode":
        return filter_urlencode(val, args, hctx, span)
    if name == "slugify":
        return filter_slugify(val, args, hctx, span)
    if name == "md_escape":
        return filter_md_escape(val, args, hctx, span)

    # Collections
    if name == "length":
        return filter_length(val, args, hctx, span)
    if name == "first":
        return filter_first_last(val, args, False, hctx, span)
    if name == "last":
        return filter_first_last(val, args, True, hctx, span)
    if name == "reverse":
        return filter_reverse(val, args, hctx, span)
    if name == "sort":
        return filter_sort(val, args, hctx, span)
    if name == "unique":
        return filter_unique(val, args, hctx, span)
    if name == "join":
        return filter_join(val, args, hctx, span)
    if name == "map":
        return filter_map(val, args, hctx, span)
    if name == "select":
        return filter_select_reject(val, args, True, hctx, span)
    if name == "reject":
        return filter_select_reject(val, args, False, hctx, span)
    if name == "batch":
        return filter_batch(val, args, hctx, span)
    if name == "slice":
        return filter_slice(val, args, hctx, span)
    if name == "sum":
        return filter_sum(val, args, hctx, span)
    if name == "min":
        return filter_extremum(val, args, False, hctx, span)
    if name == "max":
        return filter_extremum(val, args, True, hctx, span)
    if name == "groupby":
        return filter_groupby(val, args, hctx, span)
    if name == "dictsort":
        return filter_dictsort(val, args, hctx, span)

    # Numbers, Formatting & Explicit Dates
    if name == "default":
        return _filter_default(val, args, hctx.undefined_policy, span)
    if name == "string":
        expect_no_filter_args("string", args, span)
        return Value.VStr(stringify(val, hctx.undefined_policy, span))
    if name == "abs":
        return filter_abs(val, args, hctx, span)
    if name == "round":
        return filter_round(val, args, hctx, span)
    if name == "int":
        return filter_to_int(val, args, hctx, span)
    if name == "float":
        return filter_to_float(val, args, hctx, span)
    if name == "number":
        return filter_number(val, args, hctx, span)
    if name == "currency":
        return filter_currency(val, args, hctx, span)
    if name == "percent":
        return filter_percent(val, args, hctx, span)
    if name == "filesize":
        return filter_filesize(val, args, hctx, span)
    if name == "date":
        return filter_date(val, args, False, hctx, span)
    if name == "datetime":
        return filter_date(val, args, True, hctx, span)
    if name == "relative_time":
        return filter_relative_time(val, args, hctx, span)

    # Custom registered filters
    i: int = 0
    while i < len(reg.custom_names):
        if reg.custom_names[i] == name:
            fn: (Value, list[FilterArgValue], HelperContext, SourceSpan) -> Value = reg.custom_fns[i]
            return fn(val, args, hctx, span)
        i = i + 1

    raise GlyphExtensionError(
        GLYPH_EXTENSION_ERROR,
        "unknown filter '" + name + "'",
        span,
        "check registered filter names"
    )

def apply_filter(
    reg: FilterRegistry,
    name: str,
    val: Value,
    args: list[FilterArgValue],
    policy: UndefinedPolicy,
    tracker: BudgetTracker,
    span: SourceSpan
) -> Value:
    hctx: HelperContext = HelperContext("en-US", OutputMode.Html, True, policy, TrustTier.Trusted, tracker)
    return apply_filter_with_context(reg, name, val, args, hctx, span)
