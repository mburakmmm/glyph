# Structured diagnostic formatting (human/JSON), CLI exit code mapping, and redaction helpers for Glyph (Phase 9).
# Enforces AGENTS.md §2.12, §20, and CLI contract: no context secrets or physical disk paths exposed. Pure NOX, freestanding-safe.
import nox.json
import nox.strings
from nox.json import JsonWriter
from glyph.errors import GlyphError, GlyphSyntaxError, GlyphLoadError, GlyphSecurityError, GlyphLimitError
from glyph.validate import TemplateInfo

EXIT_OK: int = 0
EXIT_USAGE: int = 2
EXIT_SYNTAX: int = 3
EXIT_LOADER: int = 4
EXIT_SECURITY: int = 5
EXIT_RESOURCE: int = 6
EXIT_RUNTIME: int = 7
EXIT_INTERNAL: int = 8

def exit_code_for_error(err: GlyphError) -> int:
    match err.category:
        case "syntax":
            return EXIT_SYNTAX
        case "loader" | "load":
            return EXIT_LOADER
        case "security":
            return EXIT_SECURITY
        case "limit":
            return EXIT_RESOURCE
        case "undefined" | "type" | "eval" | "render" | "extension" | "cancelled":
            return EXIT_RUNTIME
        case _:
            return EXIT_INTERNAL

def format_error_human(err: GlyphError) -> str:
    loc: str = err.logical_name + ":" + str(err.line) + ":" + str(err.column)
    head: str = "error[" + err.code + "] (" + err.category + "/" + err.render_phase + ") at " + loc + ": " + err.message
    if len(err.safe_hint) > 0:
        return head + "\n  hint: " + err.safe_hint
    return head

def format_error_json(err: GlyphError) -> str:
    w: JsonWriter = JsonWriter()
    w.begin_object()
    w.write_key("ok")
    w.write_bool(False)
    w.write_key("code")
    w.write_string(err.code)
    w.write_key("category")
    w.write_string(err.category)
    w.write_key("render_phase")
    w.write_string(err.render_phase)
    w.write_key("logical_name")
    w.write_string(err.logical_name)
    w.write_key("line")
    w.write_int(err.line)
    w.write_key("column")
    w.write_int(err.column)
    w.write_key("span_start_byte")
    w.write_int(err.span_start_byte)
    w.write_key("span_end_byte")
    w.write_int(err.span_end_byte)
    w.write_key("message")
    w.write_string(err.message)
    w.write_key("safe_hint")
    w.write_string(err.safe_hint)
    w.write_key("redacted")
    w.write_bool(True)
    w.write_key("exit_code")
    w.write_int(exit_code_for_error(err))
    w.end_object()
    return w.build()

def _write_json_str_array(w: JsonWriter, items: list[str]) -> None:
    w.begin_array()
    i: int = 0
    while i < len(items):
        w.write_string(items[i])
        i = i + 1
    w.end_array()

def format_template_info_json(info: TemplateInfo) -> str:
    w: JsonWriter = JsonWriter()
    w.begin_object()
    w.write_key("logical_name")
    w.write_string(info.logical_name)
    w.write_key("has_extends")
    w.write_bool(info.has_extends)
    w.write_key("extends_target")
    w.write_string(info.extends_target)
    w.write_key("referenced_vars")
    _write_json_str_array(w, info.referenced_vars)
    w.write_key("blocks")
    _write_json_str_array(w, info.blocks)
    w.write_key("includes")
    _write_json_str_array(w, info.includes)
    w.write_key("macros")
    _write_json_str_array(w, info.macros)
    w.write_key("imports")
    _write_json_str_array(w, info.imports)
    w.end_object()
    return w.build()

def format_template_info_human(info: TemplateInfo) -> str:
    lines: list[str] = []
    lines.append("template: " + info.logical_name)
    if info.has_extends:
        lines.append("extends:  " + info.extends_target)
    lines.append("vars:     " + nox.strings.join(info.referenced_vars, ", "))
    lines.append("blocks:   " + nox.strings.join(info.blocks, ", "))
    lines.append("includes: " + nox.strings.join(info.includes, ", "))
    lines.append("macros:   " + nox.strings.join(info.macros, ", "))
    lines.append("imports:  " + nox.strings.join(info.imports, ", "))
    return nox.strings.join(lines, "\n")

class SourceMapSpan:
    logical_name: str
    line: int
    column: int
    start_byte: int
    end_byte: int
    kind: str

    def __init__(
        self: SourceMapSpan,
        logical_name: str,
        line: int,
        column: int,
        start_byte: int,
        end_byte: int,
        kind: str
    ) -> None:
        self.logical_name = logical_name
        self.line = line
        self.column = column
        self.start_byte = start_byte
        self.end_byte = end_byte
        self.kind = kind

def build_source_map_json(logical_name: str, spans: list[SourceMapSpan]) -> str:
    w: JsonWriter = JsonWriter()
    w.begin_object()
    w.write_key("logical_name")
    w.write_string(logical_name)
    w.write_key("mappings")
    w.begin_array()
    i: int = 0
    while i < len(spans):
        sp: SourceMapSpan = spans[i]
        w.begin_object()
        w.write_key("line")
        w.write_int(sp.line)
        w.write_key("col")
        w.write_int(sp.column)
        w.write_key("start")
        w.write_int(sp.start_byte)
        w.write_key("end")
        w.write_int(sp.end_byte)
        w.write_key("kind")
        w.write_string(sp.kind)
        w.end_object()
        i = i + 1
    w.end_array()
    w.end_object()
    return w.build()
