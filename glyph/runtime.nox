# AST interpreter / runtime engine for Glyph (Phase 5: Core + Include + Inheritance + Macros).
# Enforces AGENTS.md §2, §5.2-5.3, §7.2, §8.3, §9.1-9.3, §10.3 and ADR-0006.
import nox.strings
from nox.collections import OrderedDict
from glyph.errors import SourceSpan, GlyphTypeError, GlyphUndefinedError, GlyphRenderError, GlyphSecurityError, GlyphLoadError, GlyphExtensionError
from glyph.errors import GLYPH_EVAL_TYPE, GLYPH_EVAL_UNDEFINED, GLYPH_EVAL_DIV_ZERO, GLYPH_EVAL_OVERFLOW
from glyph.errors import GLYPH_RENDER_ERROR, GLYPH_RENDER_CYCLE, GLYPH_SECURITY_POLICY, GLYPH_SECURITY_CONTEXT, GLYPH_LOADER_NOT_FOUND, GLYPH_EXTENSION_ERROR
from glyph.limits import BudgetTracker
from glyph.helpers import HelperContext
from glyph.value import Value, MarkupContext, UndefinedPolicy, is_truthy, stringify, validate_float
from glyph.value import map_get, list_get, is_forbidden_key, checked_add, checked_sub
from glyph.value import checked_mul, checked_floordiv, checked_mod, INT64_MIN
from glyph.value import check_not_undef, values_equal, values_compare, values_contains
from glyph.expressions import Expr, ExprKind, UnaryOp, BinaryOp, CallArg, MapEntry
from glyph.ast import Stmt, StmtKind, IfBranch, MacroParam, TemplateAst
from glyph.validate import TemplateInfo
from glyph.options import OutputMode, RenderOptions, TrustTier, min_trust_tier
from glyph.scope import RenderScope, make_loop_metadata
from glyph.writer import GlyphWriter, RenderResult
from glyph.safety import HtmlContextTracker, OutputContext, render_contextual_value, validate_static_text_for_mode
from glyph.catalog import TranslationCatalog, default_catalog, interpolate_translation_params
from glyph.filters_text import FilterArgValue
from glyph.filters import FilterRegistry, apply_filter_with_context
from glyph.tests_registry import TestRegistry, apply_test_with_context
from glyph.functions import FunctionRegistry, apply_function_with_context
from glyph.loader import validate_logical_template_name
from glyph.inheritance import BlockVersion, TemplateLayer, InheritanceChain, build_inheritance_chain
from glyph.macros import MacroDef, MacroNamespace, MacroTable, MacroCallArg, BoundMacroArg, CallerClosure
from glyph.macros import is_private_macro_name, bind_macro_arguments

class Template:
    logical_name: str
    ast: TemplateAst
    info: TemplateInfo
    fingerprint: str
    trust_tier: TrustTier

    def __init__(
        self: Template,
        logical_name: str,
        ast: TemplateAst,
        info: TemplateInfo,
        fingerprint: str,
        trust_tier: TrustTier
    ) -> None:
        self.logical_name = logical_name
        self.ast = ast
        self.info = info
        self.fingerprint = fingerprint
        self.trust_tier = trust_tier

def _compare_order(a: Value, b: Value, op: BinaryOp, policy: UndefinedPolicy, span: SourceSpan) -> bool:
    cmp: int = values_compare(a, b, policy, span)
    match op:
        case BinaryOp.BLt:
            return cmp < 0
        case BinaryOp.BLtEq:
            return cmp <= 0
        case BinaryOp.BGt:
            return cmp > 0
        case BinaryOp.BGtEq:
            return cmp >= 0
        case _:
            return False

def _snapshot_scope_flat(scope: RenderScope) -> OrderedDict[str, Value]:
    out: OrderedDict[str, Value] = OrderedDict[str, Value]()
    fi: int = 0
    while fi < len(scope.frames):
        fr: OrderedDict[str, Value] = scope.frames[fi]
        keys: list[str] = fr.keys_list()
        ki: int = 0
        while ki < len(keys):
            k: str = keys[ki]
            out.set(k, fr.get(k))
            ki = ki + 1
        fi = fi + 1
    return out

def _snapshot_frames(scope: RenderScope) -> list[OrderedDict[str, Value]]:
    out: list[OrderedDict[str, Value]] = []
    fi: int = 0
    while fi < len(scope.frames):
        fr: OrderedDict[str, Value] = scope.frames[fi]
        cp: OrderedDict[str, Value] = OrderedDict[str, Value]()
        keys: list[str] = fr.keys_list()
        ki: int = 0
        while ki < len(keys):
            k: str = keys[ki]
            cp.set(k, fr.get(k))
            ki = ki + 1
        out.append(cp)
        fi = fi + 1
    return out

def _filters_for_trust(base: FilterRegistry, trust: TrustTier) -> FilterRegistry:
    allow_s: bool = base.allow_safe
    match trust:
        case TrustTier.Trusted:
            pass
        case _:
            allow_s = False
    if allow_s == base.allow_safe:
        return base
    out: FilterRegistry = FilterRegistry(allow_s)
    out.custom_names = base.custom_names
    out.custom_fns = base.custom_fns
    out.custom_specs = base.custom_specs
    out.generation = base.generation
    out.active_renders = base.active_renders
    out.frozen = base.frozen
    return out

def _opts_with_trust(base: RenderOptions, trust: TrustTier) -> RenderOptions:
    return RenderOptions(
        base.output_mode,
        base.autoescape,
        base.undefined_policy,
        trust,
        base.budget,
        base.locale
    )

def _empty_caller() -> CallerClosure:
    empty_p: list[str] = []
    empty_b: list[Stmt] = []
    empty_f: list[OrderedDict[str, Value]] = []
    return CallerClosure(empty_p, empty_b, empty_f, MacroTable(), SourceSpan("<caller>", 1, 1, 0, 0))

def _empty_chain() -> InheritanceChain:
    empty_l: list[TemplateLayer] = []
    empty_m: OrderedDict[str, list[BlockVersion]] = OrderedDict[str, list[BlockVersion]]()
    return InheritanceChain(empty_l, empty_m, TrustTier.Trusted)

def _tracks_markup_context(mode: OutputMode, autoescape: bool) -> bool:
    if not autoescape:
        return False
    match mode:
        case OutputMode.Html:
            return True
        case OutputMode.Xml:
            return True
        case _:
            return False

def _make_render_result(writer: GlyphWriter, tracker: BudgetTracker) -> RenderResult:
    rr: RenderResult = RenderResult(writer.to_string(), writer.bytes_written, tracker.total_ops_used, tracker.loop_steps_used, True)
    rr.bytes_flushed = writer.bytes_flushed
    rr.flush_count = writer.flush_count
    return rr

class _Evaluator:
    scope: RenderScope
    tracker: BudgetTracker
    writer: GlyphWriter
    filters: FilterRegistry
    tests: TestRegistry
    functions: FunctionRegistry
    options: RenderOptions
    active_templates: list[str]
    allow_dynamic_include: bool
    has_resolver: bool
    resolve_fn: (str, BudgetTracker) -> Template
    macros: MacroTable
    has_chain: bool
    chain: InheritanceChain
    cur_block_name: str
    cur_block_idx: int
    has_caller: bool
    active_caller: CallerClosure
    html_ctx: HtmlContextTracker
    catalog: TranslationCatalog

    def __init__(
        self: _Evaluator,
        scope: RenderScope,
        tracker: BudgetTracker,
        writer: GlyphWriter,
        filters: FilterRegistry,
        tests: TestRegistry,
        functions: FunctionRegistry,
        options: RenderOptions,
        active_templates: list[str],
        allow_dynamic_include: bool,
        has_resolver: bool,
        resolve_fn: (str, BudgetTracker) -> Template,
        macros: MacroTable,
        has_chain: bool,
        chain: InheritanceChain,
        cur_block_name: str,
        cur_block_idx: int,
        has_caller: bool,
        active_caller: CallerClosure,
        html_ctx: HtmlContextTracker,
        catalog: TranslationCatalog
    ) -> None:
        self.scope = scope
        self.tracker = tracker
        self.writer = writer
        self.filters = filters
        self.tests = tests
        self.functions = functions
        self.options = options
        self.active_templates = active_templates
        self.allow_dynamic_include = allow_dynamic_include
        self.has_resolver = has_resolver
        self.resolve_fn = resolve_fn
        self.macros = macros
        self.has_chain = has_chain
        self.chain = chain
        self.cur_block_name = cur_block_name
        self.cur_block_idx = cur_block_idx
        self.has_caller = has_caller
        self.active_caller = active_caller
        self.html_ctx = html_ctx
        self.catalog = catalog

    def _helper_ctx(self: _Evaluator) -> HelperContext:
        return HelperContext(
            self.options.locale,
            self.options.output_mode,
            self.options.autoescape,
            self.options.undefined_policy,
            self.options.trust_tier,
            self.tracker
        )

    def eval_expr(self: _Evaluator, expr: Expr) -> Value:
        self.tracker.consume_op(expr.span)
        match expr.kind:
            case ExprKind.ENull:
                return Value.VNull
            case ExprKind.EBool(b):
                return Value.VBool(b)
            case ExprKind.EInt(i):
                return Value.VInt(i)
            case ExprKind.EFloat(f):
                _vf: float = validate_float(f, expr.span)
                return Value.VFloat(f)
            case ExprKind.EStr(s):
                return Value.VStr(s)
            case ExprKind.EIdent(name):
                return self.scope.get(name, expr.span)
            case ExprKind.EList(items):
                out: list[Value] = []
                idx: int = 0
                while idx < len(items):
                    out.append(self.eval_expr(items[idx]))
                    idx = idx + 1
                return Value.VList(out)
            case ExprKind.EMap(entries):
                m: OrderedDict[str, Value] = OrderedDict[str, Value]()
                j: int = 0
                while j < len(entries):
                    ent: MapEntry = entries[j]
                    k_val: Value = self.eval_expr(ent.key)
                    match k_val:
                        case Value.VStr(ks):
                            if is_forbidden_key(ks):
                                raise GlyphSecurityError(GLYPH_SECURITY_POLICY, "forbidden map literal key", ent.span, "use plain key names")
                            m.set(ks, self.eval_expr(ent.value))
                        case _:
                            raise GlyphTypeError(GLYPH_EVAL_TYPE, "map literal keys must be strings", ent.span, "use string keys in { ... }")
                    j = j + 1
                return Value.VMap(m)
            case ExprKind.EMember(target, field):
                tv: Value = self.eval_expr(target)
                match tv:
                    case Value.VMap(map_entries):
                        return map_get(map_entries, field, expr.span)
                    case Value.VUndefined(tname):
                        return Value.VUndefined(tname + "." + field)
                    case _:
                        raise GlyphTypeError(GLYPH_EVAL_TYPE, "cannot access field '" + field + "' on non-map value", expr.span, "only map fields can be accessed with '.'")
            case ExprKind.EIndex(target, index_expr):
                tv2: Value = self.eval_expr(target)
                iv2: Value = self.eval_expr(index_expr)
                match tv2:
                    case Value.VList(items2):
                        match iv2:
                            case Value.VInt(pos):
                                return list_get(items2, pos, expr.span)
                            case _:
                                raise GlyphTypeError(GLYPH_EVAL_TYPE, "list index must be an integer", expr.span, "pass an integer index")
                    case Value.VMap(entries2):
                        match iv2:
                            case Value.VStr(k2):
                                return map_get(entries2, k2, expr.span)
                            case _:
                                raise GlyphTypeError(GLYPH_EVAL_TYPE, "map index must be a string", expr.span, "pass a string key")
                    case Value.VStr(s2):
                        match iv2:
                            case Value.VInt(pos2):
                                slen: int = len(s2)
                                p: int = pos2
                                if p < 0:
                                    p = slen + p
                                if p < 0 or p >= slen:
                                    raise GlyphTypeError(GLYPH_EVAL_TYPE, "string index out of range", expr.span, "check string length")
                                return Value.VStr(s2[p:p + 1])
                            case _:
                                raise GlyphTypeError(GLYPH_EVAL_TYPE, "string index must be an integer", expr.span, "pass an integer index")
                    case _:
                        raise GlyphTypeError(GLYPH_EVAL_TYPE, "value is not indexable", expr.span, "index only lists, maps, or strings")
            case ExprKind.EUnary(uop, operand):
                ov: Value = self.eval_expr(operand)
                match uop:
                    case UnaryOp.UNot:
                        return Value.VBool(not is_truthy(ov, self.options.undefined_policy, expr.span))
                    case UnaryOp.UNeg:
                        match ov:
                            case Value.VInt(i3):
                                if i3 == INT64_MIN:
                                    raise GlyphTypeError(GLYPH_EVAL_OVERFLOW, "integer negation overflow", expr.span, "cannot negate INT64_MIN")
                                return Value.VInt(0 - i3)
                            case Value.VFloat(f3):
                                return Value.VFloat(0.0 - f3)
                            case _:
                                raise GlyphTypeError(GLYPH_EVAL_TYPE, "unary '-' requires a number", expr.span, "negate an integer or float")
                    case UnaryOp.UPos:
                        match ov:
                            case Value.VInt(_):
                                return ov
                            case Value.VFloat(_):
                                return ov
                            case _:
                                raise GlyphTypeError(GLYPH_EVAL_TYPE, "unary '+' requires a number", expr.span, "apply '+' only to numbers")
            case ExprKind.EBinary(bop, left, right):
                return self.eval_binary(bop, left, right, expr.span)
            case ExprKind.EConditional(cond, then_expr, else_expr):
                cv: Value = self.eval_expr(cond)
                if is_truthy(cv, self.options.undefined_policy, expr.span):
                    return self.eval_expr(then_expr)
                return self.eval_expr(else_expr)
            case ExprKind.EFilter(target, fname, args):
                fv: Value = self.eval_expr(target)
                fargs: list[FilterArgValue] = []
                ai: int = 0
                while ai < len(args):
                    ca: CallArg = args[ai]
                    fargs.append(FilterArgValue(ca.name, self.eval_expr(ca.value)))
                    ai = ai + 1
                return apply_filter_with_context(self.filters, fname, fv, fargs, self._helper_ctx(), expr.span)
            case ExprKind.EIsTest(target, tname, negated, args):
                tv3: Value = self.eval_expr(target)
                targs: list[Value] = []
                ti: int = 0
                while ti < len(args):
                    targs.append(self.eval_expr(args[ti].value))
                    ti = ti + 1
                matched: bool = apply_test_with_context(self.tests, tname, tv3, targs, self._helper_ctx(), expr.span)
                if negated:
                    return Value.VBool(not matched)
                return Value.VBool(matched)
            case ExprKind.ECall(fn_name, args):
                return self._eval_call(fn_name, args, False, _empty_caller(), expr.span)

    def _resolve_macro_target(self: _Evaluator, fn_name: str, span: SourceSpan) -> MacroDef:
        if nox.strings.contains(fn_name, "."):
            parts: list[str] = nox.strings.splitn(fn_name, ".", 2)
            ns_alias: str = parts[0]
            mname: str = parts[1]
            if not self.macros.has_namespace(ns_alias):
                raise GlyphExtensionError(GLYPH_EXTENSION_ERROR, "unknown macro namespace '" + ns_alias + "'", span, "import the namespace with {% import %}")
            ns: MacroNamespace = self.macros.get_namespace(ns_alias)
            return ns.get(mname, span)
        return self.macros.get_macro(fn_name)

    def _has_macro_target(self: _Evaluator, fn_name: str) -> bool:
        if nox.strings.contains(fn_name, "."):
            parts: list[str] = nox.strings.splitn(fn_name, ".", 2)
            return self.macros.has_namespace(parts[0])
        return self.macros.has_macro(fn_name)

    def _eval_i18n_call(self: _Evaluator, is_plural: bool, args: list[CallArg], span: SourceSpan) -> Value:
        if (not is_plural and len(args) < 1) or (is_plural and len(args) < 2):
            if is_plural:
                raise GlyphTypeError(GLYPH_EVAL_TYPE, "plural() expects at least (key, count)", span, "use plural('items', n)")
            raise GlyphTypeError(GLYPH_EVAL_TYPE, "trans() expects at least a message key", span, "use trans('key', name=val)")
        key_val: Value = check_not_undef(self.eval_expr(args[0].value), self.options.undefined_policy, span)
        key_s: str = ""
        match key_val:
            case Value.VStr(ks):
                key_s = ks
            case _:
                raise GlyphTypeError(GLYPH_EVAL_TYPE, "translation key must be a string", span, "pass a string key")
        params: OrderedDict[str, Value] = OrderedDict[str, Value]()
        start_idx: int = 1
        cnt: int = 0
        if is_plural:
            cnt_val: Value = check_not_undef(self.eval_expr(args[1].value), self.options.undefined_policy, span)
            match cnt_val:
                case Value.VInt(ci_n):
                    cnt = ci_n
                case _:
                    raise GlyphTypeError(GLYPH_EVAL_TYPE, "plural() count must be an integer", span, "pass an integer count")
            params.set("count", Value.VInt(cnt))
            start_idx = 2
        ai: int = start_idx
        while ai < len(args):
            ca: CallArg = args[ai]
            av: Value = self.eval_expr(ca.value)
            if len(ca.name) > 0:
                params.set(ca.name, av)
            else:
                match av:
                    case Value.VMap(mp):
                        mkeys: list[str] = mp.keys_list()
                        mi: int = 0
                        while mi < len(mkeys):
                            mk: str = mkeys[mi]
                            if not is_forbidden_key(mk):
                                params.set(mk, mp.get(mk))
                            mi = mi + 1
                    case _:
                        raise GlyphTypeError(GLYPH_EVAL_TYPE, "trans/plural extra positional argument must be a map or keyword arg", ca.span, "pass key=value or {'key': value}")
            ai = ai + 1
        tmpl_msg: str = ""
        if is_plural:
            tmpl_msg = self.catalog.resolve_plural(key_s, cnt, self.options.locale, span)
        else:
            tmpl_msg = self.catalog.resolve_message(key_s, self.options.locale, span)
        return Value.VStr(interpolate_translation_params(tmpl_msg, params, self.options.undefined_policy, span))

    def _eval_call(
        self: _Evaluator,
        fn_name: str,
        args: list[CallArg],
        with_caller: bool,
        caller_val: CallerClosure,
        span: SourceSpan
    ) -> Value:
        if fn_name == "super":
            if len(args) > 0:
                raise GlyphTypeError(GLYPH_EVAL_TYPE, "super() takes no arguments", span, "call super()")
            return self._eval_super(span)
        if fn_name == "caller":
            return self._eval_caller(args, span)
        if fn_name == "trans" or fn_name == "t":
            return self._eval_i18n_call(False, args, span)
        if fn_name == "plural":
            return self._eval_i18n_call(True, args, span)
        if self._has_macro_target(fn_name):
            mdef: MacroDef = self._resolve_macro_target(fn_name, span)
            m_args: list[MacroCallArg] = []
            mi: int = 0
            while mi < len(args):
                ca: CallArg = args[mi]
                m_args.append(MacroCallArg(ca.name, self.eval_expr(ca.value), ca.span))
                mi = mi + 1
            return self._invoke_macro(mdef, m_args, with_caller, caller_val, span)

        cargs: list[Value] = []
        ci: int = 0
        while ci < len(args):
            ca2: CallArg = args[ci]
            if len(ca2.name) > 0:
                raise GlyphTypeError(GLYPH_EVAL_TYPE, "keyword arguments are not supported for '" + fn_name + "'", ca2.span, "pass positional arguments")
            cargs.append(self.eval_expr(ca2.value))
            ci = ci + 1
        return apply_function_with_context(self.functions, fn_name, cargs, self._helper_ctx(), span)

    def _invoke_macro(
        self: _Evaluator,
        mdef: MacroDef,
        m_args: list[MacroCallArg],
        with_caller: bool,
        caller_val: CallerClosure,
        span: SourceSpan
    ) -> Value:
        self.tracker.enter_macro(span)
        bound: list[BoundMacroArg] = bind_macro_arguments(mdef, m_args, span)

        macro_trust: TrustTier = min_trust_tier(self.options.trust_tier, mdef.trust_tier)
        macro_opts: RenderOptions = _opts_with_trust(self.options, macro_trust)
        macro_filters: FilterRegistry = _filters_for_trust(self.filters, macro_trust)

        # Evaluate default parameter expressions in the macro's captured lexical scope.
        mac_root: OrderedDict[str, Value] = OrderedDict[str, Value]()
        ckeys: list[str] = mdef.captured_globals.keys_list()
        cki: int = 0
        while cki < len(ckeys):
            ck: str = ckeys[cki]
            mac_root.set(ck, mdef.captured_globals.get(ck))
            cki = cki + 1

        mac_macros: MacroTable = self.macros.clone()
        mm_keys: list[str] = mdef.module_macros.keys_list()
        mmi: int = 0
        while mmi < len(mm_keys):
            mmk: str = mm_keys[mmi]
            mac_macros.define_macro(mdef.module_macros.get(mmk))
            mmi = mmi + 1

        mac_scope: RenderScope = RenderScope(mac_root)
        mac_writer: GlyphWriter = GlyphWriter(self.tracker)
        mac_ctx_base: HtmlContextTracker = HtmlContextTracker()
        def_ev: _Evaluator = _Evaluator(
            mac_scope,
            self.tracker,
            mac_writer,
            macro_filters,
            self.tests,
            self.functions,
            macro_opts,
            self.active_templates,
            self.allow_dynamic_include,
            self.has_resolver,
            self.resolve_fn,
            mac_macros,
            False,
            _empty_chain(),
            "",
            -1,
            with_caller,
            caller_val,
            HtmlContextTracker(),
            self.catalog
        )

        # Apply explicit bound args and evaluate remaining default params.
        bi: int = 0
        while bi < len(bound):
            b: BoundMacroArg = bound[bi]
            mac_scope.set_local(b.name, b.value, span)
            bi = bi + 1

        pi: int = 0
        while pi < len(mdef.params):
            mp: MacroParam = mdef.params[pi]
            already_bound: bool = False
            bci: int = 0
            while bci < len(bound):
                if bound[bci].name == mp.name:
                    already_bound = True
                bci = bci + 1
            if not already_bound and mp.has_default:
                mac_scope.set_local(mp.name, def_ev.eval_expr(mp.default_expr), mp.span)
            pi = pi + 1

        def_ev.exec_stmts(mdef.body)
        mac_writer.flush()
        out_str: str = mac_writer.to_string()
        self.tracker.exit_macro()

        match self.options.output_mode:
            case OutputMode.Html:
                if self.options.autoescape:
                    if not def_ev.html_ctx.same_state(mac_ctx_base):
                        return Value.VStr(out_str)
                    match macro_trust:
                        case TrustTier.Trusted:
                            return Value.VTrustedMarkup(out_str, MarkupContext.SafeHtml)
                        case _:
                            return Value.VStr(out_str)
                return Value.VStr(out_str)
            case _:
                return Value.VStr(out_str)

    def _eval_caller(self: _Evaluator, args: list[CallArg], span: SourceSpan) -> Value:
        if not self.has_caller:
            raise GlyphRenderError(GLYPH_RENDER_ERROR, "caller() invoked outside a {% call %} block", span, "invoke caller() only inside macros called via {% call %}")
        cc: CallerClosure = self.active_caller
        if len(args) != len(cc.params):
            raise GlyphTypeError(
                GLYPH_EVAL_TYPE,
                "caller() argument count mismatch (expected " + str(len(cc.params)) + ", got " + str(len(args)) + ")",
                span,
                "match {% call(...) %} parameters"
            )
        arg_vals: list[Value] = []
        ai: int = 0
        while ai < len(args):
            if len(args[ai].name) > 0:
                raise GlyphTypeError(GLYPH_EVAL_TYPE, "caller() does not support keyword arguments", args[ai].span, "pass positional arguments to caller()")
            arg_vals.append(self.eval_expr(args[ai].value))
            ai = ai + 1

        self.tracker.enter_macro(span)
        call_frames: list[OrderedDict[str, Value]] = []
        fi: int = 0
        while fi < len(cc.captured_frames):
            call_frames.append(cc.captured_frames[fi])
            fi = fi + 1
        param_frame: OrderedDict[str, Value] = OrderedDict[str, Value]()
        pi: int = 0
        while pi < len(cc.params):
            param_frame.set(cc.params[pi], arg_vals[pi])
            pi = pi + 1
        call_frames.append(param_frame)

        call_scope: RenderScope = RenderScope(OrderedDict[str, Value]())
        call_scope.frames = call_frames
        call_writer: GlyphWriter = GlyphWriter(self.tracker)
        call_ctx_base: HtmlContextTracker = HtmlContextTracker()
        call_ev: _Evaluator = _Evaluator(
            call_scope,
            self.tracker,
            call_writer,
            self.filters,
            self.tests,
            self.functions,
            self.options,
            self.active_templates,
            self.allow_dynamic_include,
            self.has_resolver,
            self.resolve_fn,
            cc.macros,
            self.has_chain,
            self.chain,
            self.cur_block_name,
            self.cur_block_idx,
            False,
            _empty_caller(),
            HtmlContextTracker(),
            self.catalog
        )
        call_ev.exec_stmts(cc.body)
        call_writer.flush()
        res_str: str = call_writer.to_string()
        self.tracker.exit_macro()

        match self.options.output_mode:
            case OutputMode.Html:
                if self.options.autoescape:
                    if not call_ev.html_ctx.same_state(call_ctx_base):
                        return Value.VStr(res_str)
                    match self.options.trust_tier:
                        case TrustTier.Trusted:
                            return Value.VTrustedMarkup(res_str, MarkupContext.SafeHtml)
                        case _:
                            return Value.VStr(res_str)
                return Value.VStr(res_str)
            case _:
                return Value.VStr(res_str)

    def _eval_super(self: _Evaluator, span: SourceSpan) -> Value:
        if not self.has_chain or len(self.cur_block_name) == 0:
            raise GlyphRenderError(GLYPH_RENDER_ERROR, "super() can only be called inside an overridden block", span, "use super() inside {% block %}")
        parent_ver: BlockVersion = self.chain.get_block_at(self.cur_block_name, self.cur_block_idx + 1, span)
        parent_trust: TrustTier = min_trust_tier(self.options.trust_tier, parent_ver.trust_tier)
        parent_opts: RenderOptions = _opts_with_trust(self.options, parent_trust)
        parent_filters: FilterRegistry = _filters_for_trust(self.filters, parent_trust)

        sup_writer: GlyphWriter = GlyphWriter(self.tracker)
        sup_ctx_base: HtmlContextTracker = HtmlContextTracker()
        sup_ev: _Evaluator = _Evaluator(
            self.scope,
            self.tracker,
            sup_writer,
            parent_filters,
            self.tests,
            self.functions,
            parent_opts,
            self.active_templates,
            self.allow_dynamic_include,
            self.has_resolver,
            self.resolve_fn,
            self.macros,
            self.has_chain,
            self.chain,
            self.cur_block_name,
            self.cur_block_idx + 1,
            self.has_caller,
            self.active_caller,
            HtmlContextTracker(),
            self.catalog
        )
        self.scope.push_frame()
        sup_ev.exec_stmts(parent_ver.body)
        self.scope.pop_frame()
        sup_writer.flush()
        sup_str: str = sup_writer.to_string()

        match self.options.output_mode:
            case OutputMode.Html:
                if self.options.autoescape:
                    if not sup_ev.html_ctx.same_state(sup_ctx_base):
                        return Value.VStr(sup_str)
                    match parent_trust:
                        case TrustTier.Trusted:
                            return Value.VTrustedMarkup(sup_str, MarkupContext.SafeHtml)
                        case _:
                            return Value.VStr(sup_str)
                return Value.VStr(sup_str)
            case _:
                return Value.VStr(sup_str)

    def eval_binary(self: _Evaluator, op: BinaryOp, left_expr: Expr, right_expr: Expr, span: SourceSpan) -> Value:
        match op:
            case BinaryOp.BAnd:
                lv: Value = self.eval_expr(left_expr)
                if not is_truthy(lv, self.options.undefined_policy, span):
                    return lv
                return self.eval_expr(right_expr)
            case BinaryOp.BOr:
                lv2: Value = self.eval_expr(left_expr)
                if is_truthy(lv2, self.options.undefined_policy, span):
                    return lv2
                return self.eval_expr(right_expr)
            case _:
                l: Value = self.eval_expr(left_expr)
                r: Value = self.eval_expr(right_expr)
                return self._eval_binary_eager(op, l, r, span)

    def _eval_binary_eager(self: _Evaluator, op: BinaryOp, l: Value, r: Value, span: SourceSpan) -> Value:
        pol: UndefinedPolicy = self.options.undefined_policy
        match op:
            case BinaryOp.BEq:
                return Value.VBool(values_equal(l, r, pol, span))
            case BinaryOp.BNotEq:
                return Value.VBool(not values_equal(l, r, pol, span))
            case BinaryOp.BLt:
                return Value.VBool(_compare_order(l, r, BinaryOp.BLt, pol, span))
            case BinaryOp.BLtEq:
                return Value.VBool(_compare_order(l, r, BinaryOp.BLtEq, pol, span))
            case BinaryOp.BGt:
                return Value.VBool(_compare_order(l, r, BinaryOp.BGt, pol, span))
            case BinaryOp.BGtEq:
                return Value.VBool(_compare_order(l, r, BinaryOp.BGtEq, pol, span))
            case BinaryOp.BIn:
                return Value.VBool(values_contains(l, r, pol, span))
            case BinaryOp.BNotIn:
                return Value.VBool(not values_contains(l, r, pol, span))
            case BinaryOp.BAdd:
                return self._eval_add(l, r, span)
            case BinaryOp.BSub:
                return self._eval_arith_num(l, r, BinaryOp.BSub, span)
            case BinaryOp.BMul:
                return self._eval_arith_num(l, r, BinaryOp.BMul, span)
            case BinaryOp.BDiv:
                return self._eval_arith_num(l, r, BinaryOp.BDiv, span)
            case BinaryOp.BFloorDiv:
                return self._eval_arith_num(l, r, BinaryOp.BFloorDiv, span)
            case BinaryOp.BMod:
                return self._eval_arith_num(l, r, BinaryOp.BMod, span)
            case _:
                return Value.VNull

    def _eval_add(self: _Evaluator, l: Value, r: Value, span: SourceSpan) -> Value:
        pol: UndefinedPolicy = self.options.undefined_policy
        vl: Value = check_not_undef(l, pol, span)
        vr: Value = check_not_undef(r, pol, span)
        match vl:
            case Value.VStr(sa):
                match vr:
                    case Value.VStr(sb):
                        return Value.VStr(sa + sb)
                    case Value.VTrustedMarkup(cb, _):
                        return Value.VStr(sa + cb)
                    case _:
                        raise GlyphTypeError(GLYPH_EVAL_TYPE, "cannot add string and non-string", span, "convert non-string with |string")
            case Value.VTrustedMarkup(ca, _):
                match vr:
                    case Value.VStr(sb2):
                        return Value.VStr(ca + sb2)
                    case Value.VTrustedMarkup(cb2, _):
                        return Value.VStr(ca + cb2)
                    case _:
                        raise GlyphTypeError(GLYPH_EVAL_TYPE, "cannot add markup and non-string", span, "convert non-string with |string")
            case Value.VList(la):
                match vr:
                    case Value.VList(lb):
                        merged: list[Value] = []
                        i: int = 0
                        while i < len(la):
                            merged.append(la[i])
                            i = i + 1
                        j: int = 0
                        while j < len(lb):
                            merged.append(lb[j])
                            j = j + 1
                        return Value.VList(merged)
                    case _:
                        raise GlyphTypeError(GLYPH_EVAL_TYPE, "cannot add list and non-list", span, "both operands must be lists")
            case _:
                return self._eval_arith_num(vl, vr, BinaryOp.BAdd, span)

    def _eval_arith_num(self: _Evaluator, l: Value, r: Value, op: BinaryOp, span: SourceSpan) -> Value:
        pol: UndefinedPolicy = self.options.undefined_policy
        vl: Value = check_not_undef(l, pol, span)
        vr: Value = check_not_undef(r, pol, span)
        match vl:
            case Value.VInt(ia):
                match vr:
                    case Value.VInt(ib):
                        match op:
                            case BinaryOp.BAdd:
                                return Value.VInt(checked_add(ia, ib, span))
                            case BinaryOp.BSub:
                                return Value.VInt(checked_sub(ia, ib, span))
                            case BinaryOp.BMul:
                                return Value.VInt(checked_mul(ia, ib, span))
                            case BinaryOp.BFloorDiv:
                                return Value.VInt(checked_floordiv(ia, ib, span))
                            case BinaryOp.BMod:
                                return Value.VInt(checked_mod(ia, ib, span))
                            case BinaryOp.BDiv:
                                if ib == 0:
                                    raise GlyphTypeError(GLYPH_EVAL_DIV_ZERO, "division by zero", span, "ensure divisor is non-zero")
                                return Value.VFloat(validate_float(float(ia) / float(ib), span))
                            case _:
                                return Value.VNull
                    case Value.VFloat(fb):
                        return self._eval_float_op(float(ia), fb, op, span)
                    case _:
                        raise GlyphTypeError(GLYPH_EVAL_TYPE, "arithmetic requires numeric operands", span, "use integer or float")
            case Value.VFloat(fa):
                match vr:
                    case Value.VFloat(fb2):
                        return self._eval_float_op(fa, fb2, op, span)
                    case Value.VInt(ib2):
                        return self._eval_float_op(fa, float(ib2), op, span)
                    case _:
                        raise GlyphTypeError(GLYPH_EVAL_TYPE, "arithmetic requires numeric operands", span, "use integer or float")
            case _:
                raise GlyphTypeError(GLYPH_EVAL_TYPE, "arithmetic requires numeric operands", span, "use integer or float")

    def _eval_float_op(self: _Evaluator, a: float, b: float, op: BinaryOp, span: SourceSpan) -> Value:
        _va: float = validate_float(a, span)
        _vb: float = validate_float(b, span)
        match op:
            case BinaryOp.BAdd:
                return Value.VFloat(validate_float(a + b, span))
            case BinaryOp.BSub:
                return Value.VFloat(validate_float(a - b, span))
            case BinaryOp.BMul:
                return Value.VFloat(validate_float(a * b, span))
            case BinaryOp.BDiv:
                if b == 0.0:
                    raise GlyphTypeError(GLYPH_EVAL_DIV_ZERO, "float division by zero", span, "ensure divisor is non-zero")
                return Value.VFloat(validate_float(a / b, span))
            case BinaryOp.BFloorDiv:
                if b == 0.0:
                    raise GlyphTypeError(GLYPH_EVAL_DIV_ZERO, "float division by zero", span, "ensure divisor is non-zero")
                return Value.VFloat(validate_float(float(int(a / b)), span))
            case BinaryOp.BMod:
                if b == 0.0:
                    raise GlyphTypeError(GLYPH_EVAL_DIV_ZERO, "float modulo by zero", span, "ensure divisor is non-zero")
                raise GlyphTypeError(GLYPH_EVAL_TYPE, "modulo '%' is supported on integers only", span, "use integer operands with '%'")
            case _:
                return Value.VNull

    def exec_declarations_only(self: _Evaluator, stmts: list[Stmt]) -> None:
        i: int = 0
        while i < len(stmts):
            st: Stmt = stmts[i]
            match st.kind:
                case StmtKind.SSet(target, val_expr):
                    sval: Value = self.eval_expr(val_expr)
                    self.scope.set_local(target, sval, st.span)
                case StmtKind.SMacro(mname, params, body):
                    self._exec_macro_def(mname, params, body, st.span)
                case StmtKind.SImport(tpl_name, alias):
                    self._exec_import(tpl_name, alias, st.span)
                case StmtKind.SFromImport(tpl_name, names):
                    self._exec_from_import(tpl_name, names, st.span)
                case _:
                    pass
            i = i + 1

    def exec_stmts(self: _Evaluator, stmts: list[Stmt]) -> None:
        i: int = 0
        while i < len(stmts):
            st: Stmt = stmts[i]
            self.tracker.consume_op(st.span)
            match st.kind:
                case StmtKind.SText(txt):
                    validate_static_text_for_mode(txt, self.options.output_mode, st.span)
                    self.writer.write(txt, st.span)
                    if _tracks_markup_context(self.options.output_mode, self.options.autoescape):
                        self.html_ctx.advance_text(txt)
                case StmtKind.SOutput(expr):
                    val: Value = self.eval_expr(expr)
                    rendered: str = render_contextual_value(
                        val,
                        self.options.autoescape,
                        self.options.output_mode,
                        self.options.undefined_policy,
                        self.options.trust_tier,
                        self.html_ctx,
                        st.span
                    )
                    self.writer.write(rendered, st.span)
                case StmtKind.SIf(branches, else_body):
                    if_base: HtmlContextTracker = self.html_ctx.clone()
                    taken: bool = False
                    bi: int = 0
                    while bi < len(branches) and not taken:
                        br: IfBranch = branches[bi]
                        cond_v: Value = self.eval_expr(br.cond)
                        if is_truthy(cond_v, self.options.undefined_policy, br.span):
                            self.scope.push_frame()
                            self.exec_stmts(br.body)
                            self.scope.pop_frame()
                            taken = True
                        bi = bi + 1
                    if not taken and len(else_body) > 0:
                        self.scope.push_frame()
                        self.exec_stmts(else_body)
                        self.scope.pop_frame()
                    if _tracks_markup_context(self.options.output_mode, self.options.autoescape):
                        if not self.html_ctx.same_state(if_base):
                            self.html_ctx.mark_unknown()
                case StmtKind.SFor(targets, iterable, body, else_body):
                    self._exec_for(targets, iterable, body, else_body, st.span)
                case StmtKind.SSet(target, val_expr):
                    sval: Value = self.eval_expr(val_expr)
                    self.scope.set_local(target, sval, st.span)
                case StmtKind.SInclude(tpl_expr, with_context, ignore_missing):
                    self._exec_include(tpl_expr, with_context, ignore_missing, st.span)
                case StmtKind.SExtends(_):
                    pass
                case StmtKind.SBlock(bname, default_body):
                    self._exec_block(bname, default_body, st.span)
                case StmtKind.SMacro(mname, params, body):
                    self._exec_macro_def(mname, params, body, st.span)
                case StmtKind.SImport(tpl_name, alias):
                    self._exec_import(tpl_name, alias, st.span)
                case StmtKind.SFromImport(tpl_name, names):
                    self._exec_from_import(tpl_name, names, st.span)
                case StmtKind.SCallBlock(mac_target, args, caller_params, body):
                    self._exec_call_block(mac_target, args, caller_params, body, st.span)
            i = i + 1

    def _exec_block(self: _Evaluator, bname: str, default_body: list[Stmt], span: SourceSpan) -> None:
        blk_base: HtmlContextTracker = self.html_ctx.clone()
        if self.has_chain and self.chain.has_block(bname):
            ver: BlockVersion = self.chain.get_block_at(bname, 0, span)
            blk_trust: TrustTier = min_trust_tier(self.options.trust_tier, ver.trust_tier)
            blk_opts: RenderOptions = _opts_with_trust(self.options, blk_trust)
            blk_filters: FilterRegistry = _filters_for_trust(self.filters, blk_trust)
            blk_ev: _Evaluator = _Evaluator(
                self.scope,
                self.tracker,
                self.writer,
                blk_filters,
                self.tests,
                self.functions,
                blk_opts,
                self.active_templates,
                self.allow_dynamic_include,
                self.has_resolver,
                self.resolve_fn,
                self.macros,
                True,
                self.chain,
                bname,
                0,
                self.has_caller,
                self.active_caller,
                self.html_ctx,
                self.catalog
            )
            self.scope.push_frame()
            blk_ev.exec_stmts(ver.body)
            self.scope.pop_frame()
        else:
            self.scope.push_frame()
            self.exec_stmts(default_body)
            self.scope.pop_frame()
        if _tracks_markup_context(self.options.output_mode, self.options.autoescape):
            if not self.html_ctx.same_state(blk_base):
                self.html_ctx.mark_unknown()

    def _exec_macro_def(
        self: _Evaluator,
        mname: str,
        params: list[MacroParam],
        body: list[Stmt],
        span: SourceSpan
    ) -> None:
        snap: OrderedDict[str, Value] = _snapshot_scope_flat(self.scope)
        mdef: MacroDef = MacroDef(mname, params, body, snap, self.macros.macros, self.options.trust_tier, span)
        self.macros.define_macro(mdef)

    def _load_macro_module(self: _Evaluator, tpl_name: str, span: SourceSpan) -> MacroTable:
        safe_name: str = validate_logical_template_name(tpl_name)
        if not self.has_resolver:
            raise GlyphRenderError(GLYPH_RENDER_ERROR, "import is not available without a template resolver", span, "render via Environment")
        ai: int = 0
        while ai < len(self.active_templates):
            if self.active_templates[ai] == safe_name:
                raise GlyphRenderError(GLYPH_RENDER_CYCLE, "cyclic import detected for '" + safe_name + "'", span, "break circular template import")
            ai = ai + 1

        self.tracker.enter_include(span)
        resolver: (str, BudgetTracker) -> Template = self.resolve_fn
        imp_tpl: Template = resolver(safe_name, self.tracker)

        imp_trust: TrustTier = min_trust_tier(self.options.trust_tier, imp_tpl.trust_tier)
        imp_opts: RenderOptions = _opts_with_trust(self.options, imp_trust)
        imp_filters: FilterRegistry = _filters_for_trust(self.filters, imp_trust)

        child_active: list[str] = []
        bi: int = 0
        while bi < len(self.active_templates):
            child_active.append(self.active_templates[bi])
            bi = bi + 1
        child_active.append(safe_name)

        imp_scope: RenderScope = RenderScope(OrderedDict[str, Value]())
        imp_macros: MacroTable = MacroTable()
        imp_writer: GlyphWriter = GlyphWriter(self.tracker)
        imp_ev: _Evaluator = _Evaluator(
            imp_scope,
            self.tracker,
            imp_writer,
            imp_filters,
            self.tests,
            self.functions,
            imp_opts,
            child_active,
            self.allow_dynamic_include,
            self.has_resolver,
            self.resolve_fn,
            imp_macros,
            False,
            _empty_chain(),
            "",
            -1,
            False,
            _empty_caller(),
            HtmlContextTracker(),
            self.catalog
        )
        imp_ev.exec_declarations_only(imp_tpl.ast.body)
        self.tracker.exit_include()
        return imp_macros

    def _exec_import(self: _Evaluator, tpl_name: str, alias: str, span: SourceSpan) -> None:
        imp_macros: MacroTable = self._load_macro_module(tpl_name, span)
        exported: OrderedDict[str, MacroDef] = OrderedDict[str, MacroDef]()
        mkeys: list[str] = imp_macros.macros.keys_list()
        i: int = 0
        while i < len(mkeys):
            mk: str = mkeys[i]
            if not is_private_macro_name(mk):
                exported.set(mk, imp_macros.macros.get(mk))
            i = i + 1
        ns: MacroNamespace = MacroNamespace(alias, exported)
        self.macros.register_namespace(alias, ns)

    def _exec_from_import(self: _Evaluator, tpl_name: str, names: list[str], span: SourceSpan) -> None:
        imp_macros: MacroTable = self._load_macro_module(tpl_name, span)
        i: int = 0
        while i < len(names):
            sym: str = names[i]
            if is_private_macro_name(sym):
                raise GlyphSecurityError(GLYPH_SECURITY_POLICY, "cannot import private macro '" + sym + "'", span, "macros starting with '_' are private")
            if not imp_macros.has_macro(sym):
                raise GlyphExtensionError(GLYPH_EXTENSION_ERROR, "template '" + tpl_name + "' has no macro '" + sym + "'", span, "check exported macro names")
            self.macros.define_macro(imp_macros.get_macro(sym))
            i = i + 1

    def _exec_call_block(
        self: _Evaluator,
        mac_target: str,
        args: list[CallArg],
        caller_params: list[str],
        body: list[Stmt],
        span: SourceSpan
    ) -> None:
        if not self._has_macro_target(mac_target):
            raise GlyphExtensionError(GLYPH_EXTENSION_ERROR, "unknown macro '" + mac_target + "' in call block", span, "define or import the macro before calling")
        cc: CallerClosure = CallerClosure(caller_params, body, _snapshot_frames(self.scope), self.macros.clone(), span)
        res_val: Value = self._eval_call(mac_target, args, True, cc, span)
        rendered: str = render_contextual_value(
            res_val,
            self.options.autoescape,
            self.options.output_mode,
            self.options.undefined_policy,
            self.options.trust_tier,
            self.html_ctx,
            span
        )
        self.writer.write(rendered, span)

    def _exec_for(
        self: _Evaluator,
        targets: list[str],
        iterable: Expr,
        body: list[Stmt],
        else_body: list[Stmt],
        span: SourceSpan
    ) -> None:
        loop_base: HtmlContextTracker = self.html_ctx.clone()
        seq_val: Value = check_not_undef(self.eval_expr(iterable), self.options.undefined_policy, span)
        match seq_val:
            case Value.VList(items):
                if len(targets) != 1:
                    raise GlyphTypeError(GLYPH_EVAL_TYPE, "list iteration expects 1 loop target variable", span, "use '{% for item in list %}'")
                n: int = len(items)
                if n == 0:
                    if len(else_body) > 0:
                        self.scope.push_frame()
                        self.exec_stmts(else_body)
                        self.scope.pop_frame()
                        if _tracks_markup_context(self.options.output_mode, self.options.autoescape):
                            if not self.html_ctx.same_state(loop_base):
                                self.html_ctx.mark_unknown()
                    return
                idx: int = 0
                while idx < n:
                    self.tracker.consume_loop_step(span)
                    self.scope.push_frame()
                    self.scope.set_local(targets[0], items[idx], span)
                    self.scope.set_local("loop", make_loop_metadata(idx, n), span)
                    self.exec_stmts(body)
                    self.scope.pop_frame()
                    if _tracks_markup_context(self.options.output_mode, self.options.autoescape):
                        if not self.html_ctx.same_state(loop_base):
                            self.html_ctx.mark_unknown()
                    idx = idx + 1
            case Value.VMap(entries):
                keys: list[str] = entries.keys_list()
                kn: int = len(keys)
                if kn == 0:
                    if len(else_body) > 0:
                        self.scope.push_frame()
                        self.exec_stmts(else_body)
                        self.scope.pop_frame()
                        if _tracks_markup_context(self.options.output_mode, self.options.autoescape):
                            if not self.html_ctx.same_state(loop_base):
                                self.html_ctx.mark_unknown()
                    return
                kidx: int = 0
                while kidx < kn:
                    self.tracker.consume_loop_step(span)
                    key_s: str = keys[kidx]
                    self.scope.push_frame()
                    if len(targets) == 1:
                        self.scope.set_local(targets[0], Value.VStr(key_s), span)
                    elif len(targets) == 2:
                        self.scope.set_local(targets[0], Value.VStr(key_s), span)
                        self.scope.set_local(targets[1], entries.get(key_s), span)
                    else:
                        raise GlyphTypeError(GLYPH_EVAL_TYPE, "map iteration expects 1 or 2 target variables", span, "use '{% for k, v in map %}'")
                    self.scope.set_local("loop", make_loop_metadata(kidx, kn), span)
                    self.exec_stmts(body)
                    self.scope.pop_frame()
                    if _tracks_markup_context(self.options.output_mode, self.options.autoescape):
                        if not self.html_ctx.same_state(loop_base):
                            self.html_ctx.mark_unknown()
                    kidx = kidx + 1
            case _:
                raise GlyphTypeError(GLYPH_EVAL_TYPE, "for-loop iterable must be a list or map", span, "iterate over a list or map")

    def _exec_include(
        self: _Evaluator,
        tpl_expr: Expr,
        with_context: bool,
        ignore_missing: bool,
        span: SourceSpan
    ) -> None:
        if _tracks_markup_context(self.options.output_mode, self.options.autoescape):
            cur_octx: OutputContext = self.html_ctx.current_output_context()
            match cur_octx:
                case OutputContext.HtmlText:
                    pass
                case _:
                    raise GlyphSecurityError(
                        GLYPH_SECURITY_CONTEXT,
                        "{% include %} is only allowed in text content context",
                        span,
                        "move {% include %} outside tags, attributes, comments, or <script>/<style> blocks"
                    )
        is_literal: bool = False
        match tpl_expr.kind:
            case ExprKind.EStr(_):
                is_literal = True
            case _:
                is_literal = False
        if not is_literal:
            if not self.allow_dynamic_include:
                raise GlyphSecurityError(
                    GLYPH_SECURITY_POLICY,
                    "dynamic include requires allow_dynamic_include policy",
                    span,
                    "pass a literal template name string"
                )
            match self.options.trust_tier:
                case TrustTier.Trusted:
                    pass
                case _:
                    raise GlyphSecurityError(
                        GLYPH_SECURITY_POLICY,
                        "dynamic include is forbidden in restricted/untrusted mode",
                        span,
                        "pass a literal template name string"
                    )

        name_val: Value = check_not_undef(self.eval_expr(tpl_expr), self.options.undefined_policy, span)
        inc_raw: str = ""
        match name_val:
            case Value.VStr(s):
                inc_raw = s
            case _:
                raise GlyphTypeError(GLYPH_EVAL_TYPE, "include target must evaluate to a string", span, "pass a string template path")

        inc_name: str = validate_logical_template_name(inc_raw)
        if not self.has_resolver:
            raise GlyphRenderError(GLYPH_RENDER_ERROR, "include is not available without a template resolver", span, "render via Environment")

        ai: int = 0
        while ai < len(self.active_templates):
            if self.active_templates[ai] == inc_name:
                raise GlyphRenderError(GLYPH_RENDER_CYCLE, "cyclic include detected for '" + inc_name + "'", span, "remove circular include")
            ai = ai + 1

        self.tracker.enter_include(span)
        resolver: (str, BudgetTracker) -> Template = self.resolve_fn
        found: bool = True
        child_tpl: Template = Template("", TemplateAst("", [], False, ""), TemplateInfo("", [], [], [], [], [], False, ""), "", TrustTier.Untrusted)
        try:
            child_tpl = resolver(inc_name, self.tracker)
        except GlyphLoadError as le:
            if ignore_missing and le.code == GLYPH_LOADER_NOT_FOUND:
                found = False
            else:
                self.tracker.exit_include()
                raise le

        if not found:
            self.tracker.exit_include()
            return

        child_trust: TrustTier = min_trust_tier(self.options.trust_tier, child_tpl.trust_tier)
        child_opts: RenderOptions = _opts_with_trust(self.options, child_trust)
        child_filters: FilterRegistry = _filters_for_trust(self.filters, child_trust)

        child_scope: RenderScope = RenderScope(OrderedDict[str, Value]())
        if with_context:
            child_scope = self.scope.clone_for_include()

        child_active: list[str] = []
        bi: int = 0
        while bi < len(self.active_templates):
            child_active.append(self.active_templates[bi])
            bi = bi + 1
        child_active.append(inc_name)

        child_inc_base: HtmlContextTracker = HtmlContextTracker()
        child_ev: _Evaluator = _Evaluator(
            child_scope,
            self.tracker,
            self.writer,
            child_filters,
            self.tests,
            self.functions,
            child_opts,
            child_active,
            self.allow_dynamic_include,
            self.has_resolver,
            self.resolve_fn,
            MacroTable(),
            False,
            _empty_chain(),
            "",
            -1,
            False,
            _empty_caller(),
            HtmlContextTracker(),
            self.catalog
        )
        child_ev.exec_stmts(child_tpl.ast.body)
        if _tracks_markup_context(self.options.output_mode, self.options.autoescape):
            if not child_ev.html_ctx.same_state(child_inc_base):
                self.html_ctx.mark_unknown()
        self.tracker.exit_include()

def _noop_resolve(name: str, _tr: BudgetTracker) -> Template:
    raise GlyphRenderError(GLYPH_RENDER_ERROR, "no resolver configured for '" + name + "'", SourceSpan(name, 1, 1, 0, 0), "use Environment")

def _build_chain_layers(
    leaf: Template,
    tracker: BudgetTracker,
    has_resolver: bool,
    resolve_fn: (str, BudgetTracker) -> Template
) -> list[TemplateLayer]:
    layers: list[TemplateLayer] = [TemplateLayer(leaf.logical_name, leaf.ast, leaf.trust_tier)]
    seen: list[str] = [leaf.logical_name]
    cur: Template = leaf
    depth_entered: int = 0
    while cur.ast.has_extends:
        if not has_resolver:
            raise GlyphRenderError(GLYPH_RENDER_ERROR, "extends requires a template resolver", SourceSpan(cur.logical_name, 1, 1, 0, 0), "render via Environment")
        parent_name: str = validate_logical_template_name(cur.ast.extends_target)
        si: int = 0
        while si < len(seen):
            if seen[si] == parent_name:
                raise GlyphRenderError(GLYPH_RENDER_CYCLE, "cyclic template inheritance detected for '" + parent_name + "'", SourceSpan(cur.logical_name, 1, 1, 0, 0), "break circular extends chain")
            si = si + 1
        seen.append(parent_name)
        tracker.enter_include(SourceSpan(cur.logical_name, 1, 1, 0, 0))
        depth_entered = depth_entered + 1
        parent_tpl: Template = resolve_fn(parent_name, tracker)
        layers.append(TemplateLayer(parent_tpl.logical_name, parent_tpl.ast, parent_tpl.trust_tier))
        cur = parent_tpl
    di: int = 0
    while di < depth_entered:
        tracker.exit_include()
        di = di + 1
    return layers

def _execute_unlocked(
    tpl: Template,
    root_vars: OrderedDict[str, Value],
    writer: GlyphWriter,
    tracker: BudgetTracker,
    filters: FilterRegistry,
    tests: TestRegistry,
    functions: FunctionRegistry,
    options: RenderOptions,
    allow_dynamic_include: bool,
    has_resolver: bool,
    resolve_fn: (str, BudgetTracker) -> Template,
    catalog: TranslationCatalog
) -> RenderResult:
    if tpl.ast.has_extends:
        layers: list[TemplateLayer] = _build_chain_layers(tpl, tracker, has_resolver, resolve_fn)
        chain: InheritanceChain = build_inheritance_chain(layers)
        eff_trust: TrustTier = min_trust_tier(options.trust_tier, chain.effective_trust)
        eff_opts: RenderOptions = _opts_with_trust(options, eff_trust)
        eff_filters: FilterRegistry = _filters_for_trust(filters, eff_trust)

        scope: RenderScope = RenderScope(root_vars)
        active: list[str] = []
        li: int = 0
        while li < len(layers):
            active.append(layers[li].logical_name)
            li = li + 1

        ev: _Evaluator = _Evaluator(
            scope,
            tracker,
            writer,
            eff_filters,
            tests,
            functions,
            eff_opts,
            active,
            allow_dynamic_include,
            has_resolver,
            resolve_fn,
            MacroTable(),
            True,
            chain,
            "",
            -1,
            False,
            _empty_caller(),
            HtmlContextTracker(),
            catalog
        )
        # Execute top-level declarations from base down to leaf child (so child overrides base declarations),
        # then execute the root layout body with block dispatch.
        ri: int = len(layers) - 1
        while ri >= 0:
            ev.exec_declarations_only(layers[ri].ast.body)
            ri = ri - 1
        root_layer: TemplateLayer = layers[len(layers) - 1]
        ev.exec_stmts(root_layer.ast.body)
        writer.flush()
        return _make_render_result(writer, tracker)

    eff_trust2: TrustTier = min_trust_tier(tpl.trust_tier, options.trust_tier)
    eff_opts2: RenderOptions = _opts_with_trust(options, eff_trust2)
    eff_filters2: FilterRegistry = _filters_for_trust(filters, eff_trust2)
    scope2: RenderScope = RenderScope(root_vars)
    active2: list[str] = [tpl.logical_name]
    ev2: _Evaluator = _Evaluator(
        scope2,
        tracker,
        writer,
        eff_filters2,
        tests,
        functions,
        eff_opts2,
        active2,
        allow_dynamic_include,
        has_resolver,
        resolve_fn,
        MacroTable(),
        False,
        _empty_chain(),
        "",
        -1,
        False,
        _empty_caller(),
        HtmlContextTracker(),
        catalog
    )
    ev2.exec_stmts(tpl.ast.body)
    writer.flush()
    return _make_render_result(writer, tracker)

def execute_template_with_catalog(
    tpl: Template,
    root_vars: OrderedDict[str, Value],
    writer: GlyphWriter,
    tracker: BudgetTracker,
    filters: FilterRegistry,
    tests: TestRegistry,
    functions: FunctionRegistry,
    options: RenderOptions,
    allow_dynamic_include: bool,
    has_resolver: bool,
    resolve_fn: (str, BudgetTracker) -> Template,
    catalog: TranslationCatalog
) -> RenderResult:
    filters.begin_use()
    tests.begin_use()
    functions.begin_use()
    res: RenderResult = RenderResult("", 0, 0, 0, False)
    try:
        res = _execute_unlocked(
            tpl,
            root_vars,
            writer,
            tracker,
            filters,
            tests,
            functions,
            options,
            allow_dynamic_include,
            has_resolver,
            resolve_fn,
            catalog
        )
    except Exception as err:
        filters.end_use()
        tests.end_use()
        functions.end_use()
        raise err
    filters.end_use()
    tests.end_use()
    functions.end_use()
    return res

def execute_template_with_resolver(
    tpl: Template,
    root_vars: OrderedDict[str, Value],
    writer: GlyphWriter,
    tracker: BudgetTracker,
    filters: FilterRegistry,
    tests: TestRegistry,
    functions: FunctionRegistry,
    options: RenderOptions,
    allow_dynamic_include: bool,
    has_resolver: bool,
    resolve_fn: (str, BudgetTracker) -> Template
) -> RenderResult:
    return execute_template_with_catalog(
        tpl,
        root_vars,
        writer,
        tracker,
        filters,
        tests,
        functions,
        options,
        allow_dynamic_include,
        has_resolver,
        resolve_fn,
        default_catalog()
    )

def execute_template(
    tpl: Template,
    root_vars: OrderedDict[str, Value],
    writer: GlyphWriter,
    tracker: BudgetTracker,
    filters: FilterRegistry,
    tests: TestRegistry,
    functions: FunctionRegistry,
    options: RenderOptions
) -> RenderResult:
    return execute_template_with_resolver(
        tpl,
        root_vars,
        writer,
        tracker,
        filters,
        tests,
        functions,
        options,
        False,
        False,
        _noop_resolve
    )
