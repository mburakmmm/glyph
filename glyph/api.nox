# Public entry point for Glyph (`import glyph.api`).
# Re-exports core Phase 1 types and lexer entrypoints. Freestanding-safe.
import glyph.version
from glyph.errors import SourceSpan, RelatedSpan, empty_span, format_public_error
from glyph.errors import GlyphError, GlyphSyntaxError, GlyphUndefinedError, GlyphTypeError
from glyph.errors import GlyphSecurityError, GlyphLoadError, GlyphLimitError
from glyph.errors import GlyphRenderError, GlyphExtensionError, GlyphCancelledError
from glyph.limits import ResourceBudget, BudgetTracker, default_budget, restricted_budget
from glyph.value import Value, MarkupContext, UndefinedPolicy, from_json, from_json_str
from glyph.value import is_truthy, stringify, map_get, list_get
from glyph.token import Token, TokenKind, token_kind_name
from glyph.lexer import tokenize, tokenize_with_budget

def engine_version() -> str:
    return glyph.version.version()

def min_nox_version() -> str:
    return glyph.version.min_nox_version()
