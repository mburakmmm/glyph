# Glyph version metadata (Phase 6: Contextual Escaping and Security Hardening).
# Pure NOX, freestanding-compatible (no hosted-only imports).

GLYPH_VERSION: str = "0.4.0"
GLYPH_MIN_NOX_VERSION: str = "2.1.186"

def version() -> str:
    return GLYPH_VERSION

def min_nox_version() -> str:
    return GLYPH_MIN_NOX_VERSION
