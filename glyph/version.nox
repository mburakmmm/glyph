# Glyph version metadata (Phase 0 audit baseline).
# Keep core free of framework imports and hosted-only modules so freestanding/WASM checks stay valid.

GLYPH_VERSION: str = "0.0.1-audit"
GLYPH_MIN_NOX_VERSION: str = "2.1.186"

def version() -> str:
    return GLYPH_VERSION

def min_nox_version() -> str:
    return GLYPH_MIN_NOX_VERSION
