# Pure in-memory template loader for Glyph (freestanding/WASM/test/embedded safe).
# Enforces AGENTS.md §11.2 and ADR-0005.
from nox.collections import OrderedDict
from glyph.errors import SourceSpan, GlyphLoadError, empty_span, GLYPH_LOADER_NOT_FOUND
from glyph.options import TrustTier
from glyph.loader import SourceRecord, Loader, compute_fingerprint, validate_logical_template_name

class MemoryLoader:
    templates: OrderedDict[str, SourceRecord]
    default_trust: TrustTier

    def __init__(self: MemoryLoader) -> None:
        m: OrderedDict[str, SourceRecord] = OrderedDict[str, SourceRecord]()
        self.templates = m
        self.default_trust = TrustTier.Trusted

    def set_trust_tier(self: MemoryLoader, tier: TrustTier) -> None:
        self.default_trust = tier

    def put(self: MemoryLoader, logical_name: str, content: str) -> None:
        safe_name: str = validate_logical_template_name(logical_name)
        fp: str = compute_fingerprint(content)
        rec: SourceRecord = SourceRecord(safe_name, content, "memory://" + safe_name, fp, self.default_trust)
        self.templates.set(safe_name, rec)

    def put_with_trust(self: MemoryLoader, logical_name: str, content: str, trust: TrustTier) -> None:
        safe_name: str = validate_logical_template_name(logical_name)
        fp: str = compute_fingerprint(content)
        rec: SourceRecord = SourceRecord(safe_name, content, "memory://" + safe_name, fp, trust)
        self.templates.set(safe_name, rec)

    def has(self: MemoryLoader, logical_name: str) -> bool:
        return self.templates.contains(logical_name)

    def load(self: MemoryLoader, logical_name: str) -> SourceRecord:
        safe_name: str = validate_logical_template_name(logical_name)
        if not self.templates.contains(safe_name):
            sp: SourceSpan = empty_span(safe_name)
            raise GlyphLoadError(
                GLYPH_LOADER_NOT_FOUND,
                "template '" + safe_name + "' not found",
                sp,
                "verify template name in MemoryLoader"
            )
        return self.templates.get(safe_name)

    def as_loader(self: MemoryLoader) -> Loader:
        tpls: OrderedDict[str, SourceRecord] = self.templates
        def _load(name: str) -> SourceRecord:
            safe_name: str = validate_logical_template_name(name)
            if not tpls.contains(safe_name):
                raise GlyphLoadError(
                    GLYPH_LOADER_NOT_FOUND,
                    "template '" + safe_name + "' not found",
                    empty_span(safe_name),
                    "verify template name in MemoryLoader"
                )
            return tpls.get(safe_name)
        return Loader("memory", _load)
